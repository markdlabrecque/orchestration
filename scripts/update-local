#!/usr/bin/env bash
set -euo pipefail
script=$(node -e 'console.log(require("node:fs").realpathSync(process.argv[1]))' "$0")
cd "$(dirname "$script")/.."
source scripts/stable-checkout.sh
orch_require_stable_checkout
if [[ -n "$(git status --porcelain)" ]]; then
  printf '%s\n' 'Stable checkout has uncommitted work; commit or stash it before updating.' >&2
  exit 1
fi
git pull --ff-only
pnpm install --frozen-lockfile
./bin/orch --version
printf '%s\n' 'Global workflow preserved. Use orch workflow diff to review shipped changes.'
