SCHEMA = """
CREATE TABLE IF NOT EXISTS tickets (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    id TEXT NOT NULL UNIQUE,
    title TEXT,
    url TEXT,
    phase TEXT NOT NULL,
    prior_phase TEXT,
    review_rounds INTEGER NOT NULL DEFAULT 0,
    pid INTEGER,
    session_id TEXT,
    worktree TEXT,
    attempt INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL,
    retired_at TEXT
);
CREATE TABLE IF NOT EXISTS events (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    ticket TEXT NOT NULL,
    ts TEXT NOT NULL,
    kind TEXT NOT NULL,
    from_phase TEXT,
    to_phase TEXT,
    detail TEXT
);
CREATE TABLE IF NOT EXISTS ci_results (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    ticket TEXT NOT NULL,
    sha TEXT NOT NULL,
    verdict TEXT NOT NULL,
    ts TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS baselines (
    id TEXT PRIMARY KEY,
    record TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS selftest_runs (
    run TEXT PRIMARY KEY,
    state TEXT NOT NULL,
    updated_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS runs (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    ticket TEXT NOT NULL,
    role TEXT NOT NULL,
    model_requested TEXT NOT NULL,
    tier TEXT NOT NULL,
    bounce_count INTEGER NOT NULL DEFAULT 0,
    requested_at TEXT NOT NULL,
    model_resolved TEXT,
    agent_id TEXT,
    resolved_at TEXT,
    match INTEGER,
    effort_requested TEXT,
    effort_resolved TEXT
);
"""


class Refusal(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


# ---- locations ------------------------------------------------------------

# A project lives in $ORCH_PROJECTS_DIR/<project> (default ~/Projects):
# .orch (KEY=VALUE config), .agents/orchestration (state) and code/ (the main
# checkout and the ticket worktrees). Config keys resolve: environment, then
# .orch, then the default. Mirrors scripts/orch-project.sh.

def projects_dir():
    return os.path.realpath(os.environ.get("ORCH_PROJECTS_DIR")
                            or os.path.expanduser("~/Projects"))


def _root_under(path, projects):
    rel = os.path.relpath(os.path.realpath(path), projects)
    if rel in (".", "..") or rel.startswith(".." + os.sep):
        return None
    return os.path.join(projects, rel.split(os.sep)[0])


def git_common_parent(path):
    """The main checkout of the repo at `path`, or None."""
    p = subprocess.run(["git", "-C", path, "rev-parse", "--path-format=absolute",
                        "--git-common-dir"], capture_output=True, text=True, timeout=5)
    if p.returncode != 0 or not p.stdout.strip():
        return None
    common = p.stdout.strip()
    if not os.path.isabs(common):
        common = os.path.join(path, common)
    return os.path.dirname(os.path.realpath(common))


def project_root(start=None):
    """The folder directly under the projects folder that holds `start`
    (default the cwd). A worktree outside it is traced through its main
    checkout."""
    start = os.path.realpath(start or os.getcwd())
    projects = projects_dir()
    root = _root_under(start, projects)
    if root is None:
        main = git_common_parent(start)
        root = main and _root_under(main, projects)
    if not root:
        raise Refusal(1, "%s is not inside a project folder (%s/<project-name>)"
                      % (start, projects))
    return root


def read_orch(root):
    """KEY=VALUE pairs of <root>/.orch; the last of a key wins."""
    values = {}
    try:
        f = open(os.path.join(root, ".orch"))
    except OSError:
        return values
    with f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("export "):
                line = line[len("export "):].lstrip()
            key, sep, val = line.partition("=")
            if not sep:
                continue
            val = val.strip()
            if val[:1] in ("'", '"'):
                end = val.find(val[0], 1)
                val = val[1:end] if end != -1 else val[1:]
            else:
                val = re.split(r"\s#", val, maxsplit=1)[0].strip()
            values[key.strip()] = val
    return values


def orch_get(root, key):
    return os.environ.get(key) or read_orch(root).get(key) or None


def orch_path(root, path):
    return path if os.path.isabs(path) else os.path.join(root, path)


def main_checkout():
    root = project_root()
    if not os.path.isfile(os.path.join(root, ".orch")):
        raise Refusal(1, "%s not found; run the orchestration:setup-project skill first"
                      % os.path.join(root, ".orch"))
    named = orch_get(root, "MAIN_CHECKOUT")
    if named:
        path = os.path.realpath(orch_path(root, named))
        if not os.path.isdir(path):
            raise Refusal(1, "MAIN_CHECKOUT %s does not exist" % path)
        return path
    wt_root = orch_path(root, orch_get(root, "WORKTREE_ROOT") or "code")
    found = sorted(os.path.join(wt_root, d) for d in
                   (os.listdir(wt_root) if os.path.isdir(wt_root) else [])
                   if os.path.isdir(os.path.join(wt_root, d, ".git")))
    if len(found) != 1:
        raise Refusal(1, "%s git checkouts in %s; set MAIN_CHECKOUT in %s"
                      % ("no" if not found else "several", wt_root,
                         os.path.join(root, ".orch")))
    return os.path.realpath(found[0])


def base_branch():
    """(BASE_BRANCH or None, the .orch it should be set in)."""
    root = project_root()
    return orch_get(root, "BASE_BRANCH"), os.path.join(root, ".orch")


def state_dir():
    home = os.environ.get("ORCH_HOME")
    if home:
        return os.path.abspath(home)
    return os.path.join(project_root(), ".agents", "orchestration")


def detect_platform():
    """The platform the environment shows. With no host signal (a plain
    terminal), headless."""
    if os.environ.get("HERDR_ENV") == "1":
        return "herdr"
    if os.environ.get("ORCA_TERMINAL_HANDLE") or os.environ.get("ORCA_WORKTREE_ID"):
        return "orca"
    if os.environ.get("CLAUDE_CODE_ENTRYPOINT") == "claude-desktop":
        return "desktop"
    return "headless"


def resolve_platform():
    """ORCH_PLATFORM, else the platform the environment shows."""
    forced = os.environ.get("ORCH_PLATFORM")
    if forced:
        if forced not in PLATFORMS:
            raise Refusal(EXIT_USAGE, "ORCH_PLATFORM must be one of %s, not %r"
                          % (", ".join(PLATFORMS), forced))
        return forced
    return detect_platform()


def harness_markers():
    """The harnesses whose markers are in the environment."""
    return [h for h, key, value in HARNESS_MARKERS
            if os.environ.get(key) and (value is None or os.environ.get(key) == value)]


def detect_harness():
    """The harness this orch runs under, from what the harnesses export to
    their tools. With several (one agent started from another), the nearest
    agent process up the process tree decides; with none, claude."""
    found = harness_markers()
    if len(found) == 1:
        return found[0]
    if found:
        pid, harness = walk_to_agent(os.getppid(), 12)
        return harness if harness in found else found[0]
    return "claude"


def resolve_harness(given=None):
    """(harness, source): `given` (a --harness flag), else ORCH_HARNESS, else
    the detected one, else claude."""
    if given:
        return given, "flag"
    forced = os.environ.get("ORCH_HARNESS")
    if forced:
        if forced not in HARNESSES:
            raise Refusal(EXIT_USAGE, "ORCH_HARNESS must be one of %s, not %r"
                          % (", ".join(HARNESSES), forced))
        return forced, "env"
    if harness_markers():
        return detect_harness(), "detected"
    return "claude", "default"


def check_harness_platform(harness, platform):
    if platform == "desktop" and harness != "claude":
        raise Refusal(EXIT_GATE, "desktop hosts Claude sessions only; %s ticket sessions"
                      " need headless, orca or herdr" % harness)


def harness_bin(harness):
    var, default = HARNESS_BIN[harness]
    return os.environ.get(var, default)


def require_platform(given=None):
    """The platform a launch/resume/retire uses: `given`, else the resolved one."""
    return given or resolve_platform()


def platform_bin(platform):
    if platform == "orca":
        return os.environ.get("ORCH_ORCA_BIN", "orca")
    if platform == "herdr":
        return os.environ.get("ORCH_HERDR_BIN", "herdr")
    return None


def load_config(sdir):
    cfg = dict(DEFAULT_CONFIG)
    path = os.path.join(sdir, "config.json")
    if os.path.exists(path):
        try:
            with open(path) as f:
                data = json.load(f)
        except (OSError, ValueError) as e:
            raise Refusal(EXIT_GATE, "invalid config.json at %s: %s" % (path, e))
        if not isinstance(data, dict):
            raise Refusal(EXIT_GATE, "invalid config.json at %s: expected a JSON object"
                          % path)
        cfg.update(data)
    return cfg


class StateConnection(sqlite3.Connection):
    """Publication state is process-local; the revision itself lives in SQLite."""


def connect(sdir, timeout=30):
    os.makedirs(sdir, exist_ok=True)
    db = sqlite3.connect(os.path.join(sdir, "state.db"), timeout=timeout,
                         isolation_level=None, factory=StateConnection)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA busy_timeout=%d" % int(timeout * 1000))
    if db.execute("PRAGMA journal_mode").fetchone()[0].lower() != "wal":
        db.execute("PRAGMA journal_mode=WAL")
    have = {r[0] for r in db.execute(
        "SELECT name FROM sqlite_master WHERE type='table'")}
    if not {"tickets", "events", "ci_results", "selftest_runs", "runs", "baselines"} <= have:
        db.executescript(SCHEMA)
    ticket_cols = {r[1] for r in db.execute("PRAGMA table_info(tickets)")}
    run_cols = {r[1] for r in db.execute("PRAGMA table_info(runs)")}
    needs_upgrade = (any(name not in ticket_cols for name, _ in NEW_COLUMNS)
                     or any(name not in run_cols for name in NEW_RUN_COLUMNS))
    # Initialized databases stay read-only on connect, even with an active writer.
    with transaction(db) if needs_upgrade else contextlib.nullcontext():
        cols = {r[1] for r in db.execute("PRAGMA table_info(tickets)")}
        missing_budgets = {"bounces", "ci_repairs"} - cols
        for name, decl in NEW_COLUMNS:
            if name not in cols:
                db.execute("ALTER TABLE tickets ADD COLUMN %s %s" % (name, decl))
        for row in db.execute("SELECT id, phase FROM tickets").fetchall():
            if not missing_budgets:
                break
            events = db.execute("SELECT * FROM events WHERE ticket=? ORDER BY seq",
                                (row["id"],)).fetchall()
            complete = bool(events and events[0]["kind"] == "add"
                            and events[0]["from_phase"] is None
                            and events[0]["to_phase"] == "ready")
            phase = "ready"
            for event in events[1:]:
                if event["from_phase"] is not None:
                    if event["from_phase"] != phase:
                        complete = False
                    phase = event["to_phase"]
            complete = complete and phase == row["phase"]
            for column in missing_budgets:
                origins = ("ci",) if column == "ci_repairs" else ("review", "verify")
                count = sum(e["kind"] == "phase" and e["from_phase"] in origins
                            and e["to_phase"] == "fix" for e in events) if complete else None
                db.execute("UPDATE tickets SET %s=? WHERE id=?" % column,
                           (count, row["id"]))
        run_cols = {r[1] for r in db.execute("PRAGMA table_info(runs)")}
        for name in NEW_RUN_COLUMNS:
            if name not in run_cols:
                db.execute("ALTER TABLE runs ADD COLUMN %s TEXT" % name)
    state_md_schema(db)
    db.publish_state = True
    db.publication_error = None
    return db


@contextlib.contextmanager
def transaction(db, write=True):
    db.execute("BEGIN IMMEDIATE" if write else "BEGIN")
    try:
        yield
    except BaseException:
        db.execute("ROLLBACK")
        raise
    db.execute("COMMIT")
    if write and getattr(db, "publish_state", False):
        state_md_after_commit(db)


# ---- helpers ---------------------------------------------------------------

def ps_env():
    """`lstart` is printed in the local time zone and language: pin both, so a
    start time recorded by one process compares equal in any other."""
    return dict(os.environ, LC_ALL="C", TZ="UTC")


def ps_field(pid, field):
    """One `ps` column for `pid`, whitespace-normalised; None if no such process."""
    try:
        p = subprocess.run(["ps", "-ww", "-o", field + "=", "-p", str(int(pid))],
                           capture_output=True, text=True, timeout=5, env=ps_env())
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    out = " ".join(p.stdout.split())
    return out if p.returncode == 0 and out else None


def session_alive(pid, sid, pid_start=None, activity=None):
    """True only if `pid` exists and is provably the recorded session: same
    start time when one was recorded, else `sid` is an argument on its command
    line. A reused pid never counts as alive; nor does an ended session."""
    if not pid or activity == "ended":
        return False
    if pid_start:
        return ps_field(pid, "lstart") == pid_start
    if not sid:
        return False
    cmd = ps_field(pid, "command")
    return cmd is not None and sid in cmd.split()


def row_alive(row):
    return session_alive(row["pid"], row["session_id"], row["pid_start"],
                         row["activity"])


def parse_ts(ts):
    try:
        return datetime.datetime.fromisoformat(ts) if ts else None
    except ValueError:
        return None


def age_s(ts):
    t = parse_ts(ts)
    if t is None:
        return None
    return (datetime.datetime.now(datetime.timezone.utc) - t).total_seconds()


def stall_s(cfg):
    return float(cfg.get("stall_minutes", 20)) * 60


def row_platform(row):
    return row["platform"] or "headless"


def row_harness(row):
    return row["harness"] or "claude"


def row_launch_ref(row):
    try:
        ref = json.loads(row["launch_ref"]) if row["launch_ref"] else None
    except ValueError:
        return None
    return ref if isinstance(ref, dict) else None


def health(row, alive, cfg):
    if alive:
        if row["activity"] == "idle":
            return "idle"
        if row["activity"] == "working":
            age = age_s(row["last_seen_at"])
            if age is not None and age > stall_s(cfg):
                return "stalled"
        return "working"
    return "none" if row["pid"] is None else "dead"


def is_stale(row, alive, cfg):
    if not is_active(row) or alive:
        return False
    if row_platform(row) != "headless" and row["pid"] is None:
        # Its pid only arrives with the first hook: give it stall_minutes.
        age = age_s(row["launched_at"])
        if age is not None and age < stall_s(cfg):
            return False
    return True


def get_ticket(db, tid):
    row = db.execute("SELECT * FROM tickets WHERE id=?", (tid,)).fetchone()
    if row is None:
        raise Refusal(EXIT_NOT_FOUND, "ticket not found: %s" % tid)
    return row


def ticket_dict(row, cfg, full=True, alive=None):
    if alive is None:
        alive = row_alive(row)
    d = {
        "id": row["id"],
        "phase": row["phase"],
        "status": PHASE_STATUS[row["phase"]],
        "platform": row_platform(row),
        "harness": row_harness(row),
        "health": health(row, alive, cfg),
        "activity": row["activity"],
        "last_seen_at": row["last_seen_at"],
        "review_rounds": row["review_rounds"],
        "bounces": row["bounces"],
        "ci_repairs": row["ci_repairs"],
        "pid": row["pid"],
        "alive": alive,
        "retired": row["retired_at"] is not None,
        "retired_at": row["retired_at"],
    }
    if full:
        d.update({
            "title": row["title"],
            "url": row["url"],
            "attempt": row["attempt"],
            "session_id": row["session_id"],
            "worktree": row["worktree"],
            "worktree_branch": row["worktree_branch"],
            "baseline_refresh": row["baseline_refresh"],
            "prior_phase": row["prior_phase"],
            "launch_ref": row_launch_ref(row),
            "launched_at": row["launched_at"],
            "created_at": row["created_at"],
        })
    return d


# ---- committed STATE.md projection ------------------------------------------

STATE_BEGIN = b"<!-- orch:state-md begin -->"
STATE_END = b"<!-- orch:state-md end -->"


def state_md_schema(db):
    """Triggers also track commits made by already-running older CLI versions."""
    if db.execute("SELECT 1 FROM sqlite_master WHERE name='state_md_revision'").fetchone():
        return
    with transaction(db):
        db.execute("CREATE TABLE IF NOT EXISTS state_md_revision (id INTEGER PRIMARY KEY CHECK(id=1), revision INTEGER NOT NULL)")
        db.execute("INSERT OR IGNORE INTO state_md_revision VALUES (1, 0)")
        for table, key in (("tickets", "id"), ("events", "ticket"),
                           ("runs", "ticket"), ("ci_results", "ticket"),
                           ("baselines", None)):
            for action in ("INSERT", "UPDATE", "DELETE"):
                refs = ("OLD", "NEW") if action == "UPDATE" else ("OLD",) if action == "DELETE" else ("NEW",)
                condition = " OR ".join("substr(%s.%s,1,9) != 'selftest-'" % (ref, key)
                                        for ref in refs) if key else "1"
                db.execute("CREATE TRIGGER IF NOT EXISTS state_md_%s_%s AFTER %s ON %s WHEN %s "
                           "BEGIN UPDATE state_md_revision SET revision=revision+1 WHERE id=1; END"
                           % (table, action.lower(), action, table, condition))


def state_md_root():
    try:
        return project_root()
    except Refusal:
        root = os.environ.get("ORCH_HOME")
        if not root:
            raise
        return root


def state_md_cell(value):
    """A single Markdown table cell, with no stored text claiming ownership."""
    if value is None:
        return ""
    return (str(value).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace("|", "&#124;")
            .replace("\r", "&#13;").replace("\n", "<br>"))


def state_md_snapshot(db, legacy=()):
    """One committed read snapshot. No health probes or inferred activity."""
    db.execute("BEGIN")
    try:
        revision = db.execute("SELECT revision FROM state_md_revision WHERE id=1").fetchone()[0]
        records = {}
        for table, key, order in (("tickets", "id", "id"), ("events", "ticket", "seq"),
                                  ("runs", "ticket", "seq"), ("ci_results", "ticket", "seq"),
                                  ("baselines", None, "id")):
            where = " WHERE substr(%s,1,9) != 'selftest-'" % key if key else ""
            records[table] = [dict(r) for r in db.execute("SELECT * FROM %s%s ORDER BY %s" % (table, where, order))]
        for ticket in records["tickets"]:
            ticket["status"] = PHASE_STATUS.get(ticket["phase"], ticket["phase"])
            ticket["retired"] = ticket["retired_at"] is not None
        watermark = max((r["seq"] for r in records["events"]), default=0)
        db.execute("COMMIT")
    except BaseException:
        # A failed read/export must not leave a transaction around for the next
        # lifecycle commit, nor turn a successful launch into compensation.
        if db.in_transaction:
            with contextlib.suppress(sqlite3.Error):
                db.execute("ROLLBACK")
        raise
    lines = [STATE_BEGIN.decode(), "## Committed workflow", "",
             "Source revision: %s; event watermark: %s" % (revision, watermark),
             "", "### Recorded tickets", "",
             "| Ticket | Title | Phase | Status | Attempt | Retired | Activity | Observed at |",
             "| --- | --- | --- | --- | --- | --- | --- | --- |"]
    for row in records["tickets"]:
        values = [row[key] for key in ("id", "title", "phase", "status", "attempt")]
        values += ["yes" if row["retired"] else "no", row["activity"], row["last_seen_at"]]
        lines.append("| " + " | ".join(map(state_md_cell, values)) + " |")
    lines.extend(["", "### Recorded activity", "",
                  "| Sequence | Recorded at | Ticket | Event | From | To | Detail |",
                  "| --- | --- | --- | --- | --- | --- | --- |"])
    for row in records["events"]:
        lines.append("| " + " | ".join(state_md_cell(row[key]) for key in
                     ("seq", "ts", "ticket", "kind", "from_phase", "to_phase", "detail")) + " |")
    if legacy:
        lines.extend(["", "### Retained legacy appends", "",
                      "Late writes to replaced files, retained verbatim in `.STATE.md.legacy/`."])
        for name, tail in legacy:
            # JSON strings keep arbitrary bytes reversible via surrogateescape;
            # escaping angle brackets prevents legacy text claiming ownership.
            lines.extend(["", "#### " + name, "", "```json",
                          json.dumps(tail.decode("utf-8", "surrogateescape"), ensure_ascii=True)
                          .replace("<", "\\u003c").replace(">", "\\u003e"), "```"])
    lines.extend(["", "### Detailed records"])
    for table, rows in records.items():
        lines.extend(["", "#### " + table, "", "```json",
                      json.dumps(rows, ensure_ascii=True, indent=2, sort_keys=True)
                      .replace("<", "\\u003c").replace(">", "\\u003e"), "```"])
    lines.append(STATE_END.decode())
    # Escape marker-like stored text so it cannot claim document ownership.
    return ("\n".join(lines) + "\n").encode()


def state_md_parts(data):
    """Only a unique, correctly ordered marker pair grants ownership."""
    count = data.count(STATE_BEGIN), data.count(STATE_END)
    if data.count(b"<!-- orch:state-md") != sum(count):
        raise ValueError("malformed managed markers")
    if count == (0, 0):
        if b"<!-- orch:state-md" in data:
            raise ValueError("malformed managed markers")
        return None
    if count != (1, 1):
        raise ValueError("ambiguous or missing managed markers")
    start, end = data.index(STATE_BEGIN), data.index(STATE_END)
    if (start > end or (start and data[start-1:start] != b"\n")
            or data[start+len(STATE_BEGIN):start+len(STATE_BEGIN)+1] != b"\n"
            or data[end-1:end] != b"\n"):
        raise ValueError("malformed managed markers")
    end += len(STATE_END)
    if data[end:end+1] == b"\n":
        end += 1
    elif end != len(data):
        raise ValueError("malformed managed markers")
    return start, end


def state_md_fsync_directory(path):
    directory = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def state_md_legacy(root, current_file):
    """Read tails from every superseded inode. No cursor/ack crash window.

    A retained filename is device-inode-original_length. The original length
    was read under the old appenders' inode flock, before replacement. Links
    stay forever: an old process may still hold any of these file descriptors.
    A link to the CURRENT inode is an interrupted preparation, not a late tail;
    its bytes are already in the current document and its baseline is reset on
    the next replacement. Never infer that an old writer has finished.
    """
    directory = os.path.join(root, ".STATE.md.legacy")
    identity = None
    if current_file is not None:
        stat = os.fstat(current_file.fileno())
        identity = (stat.st_dev, stat.st_ino)
    try:
        names = sorted(os.listdir(directory))
    except FileNotFoundError:
        return []
    tails = []
    for name in names:
        if not re.fullmatch(r"\d+-\d+-\d+", name):
            raise ValueError("unexpected legacy retention entry: " + name)
        device, inode, length = map(int, name.split("-"))
        with open(os.path.join(directory, name), "rb") as retained:
            stat = os.fstat(retained.fileno())
            if (stat.st_dev, stat.st_ino) != (device, inode):
                raise ValueError("legacy retention inode changed: " + name)
            if (device, inode) == identity:
                continue
            fcntl.flock(retained, fcntl.LOCK_SH)
            if os.fstat(retained.fileno()).st_size < length:
                raise ValueError("legacy retention file truncated: " + name)
            retained.seek(length)
            tail = retained.read()
            if tail:
                # Old helpers flush but do not fsync. Persist observed tails
                # before acknowledging their projection in a durable new file.
                os.fsync(retained.fileno())
                tails.append((name, tail))
    return tails


def state_md_retain(root, path, current_file, length):
    """Durably link the locked old inode BEFORE replacing its last public name."""
    directory = os.path.join(root, ".STATE.md.legacy")
    os.makedirs(directory, exist_ok=True)
    stat = os.fstat(current_file.fileno())
    prefix = "%s-%s-" % (stat.st_dev, stat.st_ino)
    name = prefix + str(length)
    previous = [entry for entry in os.listdir(directory) if entry.startswith(prefix)]
    if len(previous) > 1:
        raise ValueError("ambiguous legacy retention baseline")
    if previous:
        # A crash before replace can leave the current inode linked. Its later
        # appends are already outside managed ownership in the current file.
        if previous[0] != name:
            os.rename(os.path.join(directory, previous[0]), os.path.join(directory, name))
    else:
        os.link(path, os.path.join(directory, name))
    os.fsync(current_file.fileno())
    state_md_fsync_directory(directory)
    state_md_fsync_directory(root)


def state_md_sync(db, check=False):
    """Lock before snapshot and notes read; never hold a DB write lock here.

    Exact managed-byte equivalence is the publication acknowledgement. The
    transactional revision survives commit/export crashes, while equality also
    recognizes a complete replace even if the publisher died immediately after.
    """
    root = getattr(db, "state_root", None) or state_md_root()
    path = os.path.join(root, "STATE.md")
    temporary = None
    try:
        with contextlib.ExitStack() as stack:
            lock = stack.enter_context(open(os.path.join(root, ".STATE.md.lock"), "a+b"))
            fcntl.flock(lock, fcntl.LOCK_EX)
            current_file = None
            try:
                current_file = stack.enter_context(open(path, "rb"))
                # Old processes lock this inode, not the stable publisher lock.
                # Hold it through durable retention and replacement. A writer
                # that already opened it can safely append after we release it.
                fcntl.flock(current_file, fcntl.LOCK_EX)
                current = current_file.read()
            except FileNotFoundError:
                current = b""
            expected = state_md_snapshot(db, state_md_legacy(root, current_file))
            parts = state_md_parts(current)
            fresh = parts is not None and current[parts[0]:parts[1]] == expected
            if check or fresh:
                return fresh
            if parts is None:
                prefix = current or b"# Orchestration state\n\n## Notes\n"
                replacement = prefix + (b"\n" if not prefix.endswith(b"\n") else b"") + b"\n" + expected
            else:
                replacement = current[:parts[0]] + expected + current[parts[1]:]
            fd, temporary = tempfile.mkstemp(prefix=".STATE.md-", dir=root)
            with os.fdopen(fd, "wb") as f:
                if os.path.exists(path):
                    os.fchmod(f.fileno(), os.stat(path).st_mode & 0o777)
                if f.write(replacement) != len(replacement):
                    raise OSError("short STATE.md write")
                f.flush()
                os.fsync(f.fileno())
            if current_file is not None:
                state_md_retain(root, path, current_file, len(current))
            os.replace(temporary, path)
            temporary = None
            state_md_fsync_directory(root)
            return True
    except (OSError, ValueError, sqlite3.Error) as e:
        if check:
            return False
        raise Refusal(EXIT_GATE, "database commit succeeded; STATE.md is stale or synchronization failed: %s" % e) from e
    finally:
        if temporary is not None:
            with contextlib.suppress(OSError):
                os.unlink(temporary)


def state_md_after_commit(db):
    """Export failure is not transaction failure or a failed platform launch.

    Let lifecycle cleanup/compensation finish, but retain a controlled failure
    for the command boundary. Hooks report the same diagnostic and exit zero.
    """
    try:
        state_md_sync(db)
    except Refusal as e:
        db.publication_error = e
        print("orch: %s" % e, file=sys.stderr)


def cmd_state_md(args, db, sdir):
    fresh = state_md_sync(db, check=args.operation == "check")
    emit(args, {"fresh": fresh}, "STATE.md is " + ("fresh" if fresh else "stale"))
    if not fresh:
        raise Refusal(EXIT_GATE, "STATE.md is stale; run orch state-md rebuild")


cmd_state_md.own_tx = True


# Legacy helper retained for external callers; CLI writes use committed snapshots.

def state_md_append(root, line):
    """Append one activity line to <root>/STATE.md (append-only, flock'd);
    creates the file with the Notes/Activity skeleton on first use."""
    path = os.path.join(root, "STATE.md")
    name = read_orch(root).get("PROJECT_NAME") or os.path.basename(root)
    with open(path, "a+b") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            size = f.seek(0, os.SEEK_END)
            if size == 0:
                data = "# %s orchestration state\n\n## Notes\n\n## Activity\n\n" % name
            else:
                f.seek(-1, os.SEEK_END)
                data = "" if f.read(1) == b"\n" else "\n"
            f.write((data + line + "\n").encode("utf-8"))
            f.flush()
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def state_md_log(tid, event):
    """Compatibility shim: transaction completion publishes the stored event."""
    return


def log_event(db, tid, kind, from_phase, to_phase, detail=None):
    return db.execute(
        "INSERT INTO events (ticket, ts, kind, from_phase, to_phase, detail)"
        " VALUES (?,?,?,?,?,?)",
        (tid, now(), kind, from_phase, to_phase, detail),
    ).lastrowid


def is_active(row):
    return row["phase"] not in ("ready", "done", "blocked") and row["retired_at"] is None


# ---- shared baseline coordination --------------------------------------------


def baseline_records(db):
    return [json.loads(r[0]) for r in db.execute("SELECT record FROM baselines ORDER BY id")]


def baseline_get(db, bid):
    row = db.execute("SELECT record FROM baselines WHERE id=?", (bid,)).fetchone()
    if row is None:
        raise Refusal(EXIT_NOT_FOUND, "unknown baseline %s" % bid)
    return json.loads(row[0])


def baseline_save(db, record, tid, kind, detail=None):
    db.execute("INSERT INTO baselines VALUES (?,?) ON CONFLICT(id) DO UPDATE SET record=excluded.record",
               (record["id"], json.dumps(record, sort_keys=True)))
    row = get_ticket(db, tid)
    log_event(db, tid, "baseline-" + kind, row["phase"], row["phase"],
              json.dumps({"baseline": record["id"], "detail": detail}, sort_keys=True))


def baseline_git(path, *argv, timeout=20):
    try:
        result = subprocess.run(["git", "-C", path, *argv], text=True,
                                capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Refusal(EXIT_GATE, "baseline Git check failed: %s" % e)
    if result.returncode:
        raise Refusal(EXIT_GATE, "baseline Git check failed: %s" % result.stderr.strip())
    return result.stdout.strip()


def baseline_commit(path, revision):
    return baseline_git(path, "rev-parse", "--verify", "--end-of-options", revision + "^{commit}")


def baseline_base():
    branch, config = base_branch()
    if not branch:
        raise Refusal(EXIT_GATE, "set BASE_BRANCH in %s" % config)
    main = main_checkout()
    return main, baseline_commit(main, branch)


def baseline_contains(path, ancestor, head):
    return baseline_git(path, "merge-base", ancestor, head) == ancestor


def baseline_head(row):
    if not row["worktree"] or not os.path.isdir(row["worktree"]):
        raise Refusal(EXIT_GATE, "ticket has no available worktree")
    return baseline_commit(row["worktree"], "HEAD")


def baseline_local(row):
    path = row["worktree"]
    if not path or not os.path.isdir(path) or os.path.realpath(os.getcwd()) != os.path.realpath(path):
        raise Refusal(EXIT_GATE, "run from the recorded ticket worktree")
    main = main_checkout()
    common = baseline_git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    expected = baseline_git(main, "rev-parse", "--path-format=absolute", "--git-common-dir")
    linked = baseline_git(main, "worktree", "list", "--porcelain").splitlines()
    if (os.path.realpath(common) != os.path.realpath(expected)
            or os.path.realpath(path) == os.path.realpath(main)
            or "worktree " + os.path.realpath(path) not in linked
            or not os.path.isfile(os.path.join(path, ".git"))):
        raise Refusal(EXIT_GATE, "ticket path must be a linked worktree of MAIN_CHECKOUT")
    branch = baseline_git(path, "symbolic-ref", "--short", "HEAD")
    # worktree_ref normally holds platform JSON, not a branch. Accept the
    # legacy plain branch form, but never infer identity from current HEAD.
    expected_branch = (row["worktree_branch"]
                       or (row["worktree_ref"] if not row_worktree_ref(row) else None)
                       or worktree_name(row["id"]))
    if not expected_branch or branch != expected_branch:
        raise Refusal(EXIT_GATE, "ticket worktree is on the wrong branch")
    return path


def refuse_if_refreshing(row):
    if row["baseline_refresh"]:
        raise Refusal(EXIT_GATE, "baseline refresh active or interrupted for %s; recovery needed" % row["id"])


def baseline_idle(db, row):
    refuse_if_launching(row)
    pending = db.execute("SELECT seq FROM runs WHERE ticket=? AND completed_at IS NULL"
                         " AND (resolved_at IS NULL OR agent_id IS NULL OR model_resolved IS NULL) LIMIT 1",
                         (row["id"],)).fetchone()
    if pending:
        raise Refusal(EXIT_GATE, "pending stage run %s; completion evidence required" % pending[0])


def baseline_clean(path):
    for marker in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge",
                   "rebase-apply", "sequencer", "BISECT_LOG", "index.lock", "HEAD.lock"):
        location = baseline_git(path, "rev-parse", "--path-format=absolute", "--git-path", marker)
        if os.path.exists(location):
            raise Refusal(EXIT_GATE, "Git operation in progress: %s" % marker)
    if baseline_git(path, "status", "--porcelain", "--untracked-files=all", "--ignore-submodules=none"):
        raise Refusal(EXIT_GATE, "dirty tracked, staged or untracked work; preserve it before refresh")


def baseline_action(db, record, tid, gate):
    if tid == record["owner"] or tid not in record["affected"] or gate != record["gate"]:
        return "clear"
    if not record.get("fix_sha"):
        return "wait"
    refresh = record["refreshes"].get(tid)
    if not refresh:
        row = get_ticket(db, tid)
        if not row["worktree"]:
            return "clear"
        try:
            return "clear" if baseline_contains(row["worktree"], record["fix_sha"], baseline_head(row)) else "refresh"
        except Refusal:
            return "recovery-needed"
    row = get_ticket(db, tid)
    if row["baseline_refresh"] or refresh["status"] == "conflicted":
        return "recovery-needed"
    if refresh["status"] != "success":
        return "refresh"
    try:
        head = baseline_head(row)
    except Refusal:
        return "recovery-needed"
    return "clear" if refresh.get("ack_sha") == head else "retest"


def baseline_text(value, name):
    if not value or not value.strip():
        raise Refusal(EXIT_GATE, "%s requires nonempty evidence" % name)
    return value


def cmd_baseline(args, db, sdir):
    if args.baseline_cmd == "refresh":
        return baseline_refresh(args, db)
    # Reads do not contend with the reservation held during Git work.
    with transaction(db, write=args.baseline_cmd not in ("show", "gate")):
        op = args.baseline_cmd
        if op == "gate":
            get_ticket(db, args.ticket)
            actions = [baseline_action(db, b, args.ticket, args.gate) for b in baseline_records(db)]
            action = next((a for a in ("recovery-needed", "wait", "refresh", "retest") if a in actions), "clear")
            return emit(args, {"action": action}, action)
        if op == "confirm":
            if not TICKET_ID.fullmatch(args.id) or not args.verified:
                raise Refusal(EXIT_GATE, "confirmation requires a valid id and --verified baseline reproduction")
            get_ticket(db, args.owner)
            affected = sorted(set(args.affected))
            for tid in affected:
                get_ticket(db, tid)
            main, base = baseline_base()
            sha = baseline_commit(main, args.base_sha)
            if not baseline_contains(main, sha, base):
                raise Refusal(EXIT_GATE, "verified revision must be reachable from BASE_BRANCH")
            record = dict(id=args.id, owner=args.owner, affected=affected, gate=args.gate,
                          base_sha=sha, command=baseline_text(args.command, "command"),
                          output=baseline_text(args.output, "output"), fix_sha=None, refreshes={})
            previous = db.execute("SELECT record FROM baselines WHERE id=?", (args.id,)).fetchone()
            if previous:
                existing = json.loads(previous[0])
                if any(existing[k] != record[k] for k in record if k not in ("fix_sha", "refreshes")):
                    raise Refusal(EXIT_GATE, "baseline id already confirmed; use a new id for different evidence")
                record = existing
            else:
                baseline_save(db, record, args.owner, "confirmed", record)
        else:
            record = baseline_get(db, args.id)
            if op == "resolve":
                owner = get_ticket(db, record["owner"])
                merged = db.execute("SELECT 1 FROM events WHERE ticket=? AND kind='merged' LIMIT 1",
                                    (owner["id"],)).fetchone()
                if owner["phase"] != "done" or not merged:
                    raise Refusal(EXIT_GATE, "fix owner must be recorded merged/done")
                main, base = baseline_base()
                fix = baseline_commit(main, args.fix_sha)
                if not baseline_contains(main, fix, base):
                    raise Refusal(EXIT_GATE, "fix SHA is not integrated into BASE_BRANCH")
                if record.get("fix_sha") and record["fix_sha"] != fix:
                    raise Refusal(EXIT_GATE, "baseline already resolved to another fix")
                if not record.get("fix_sha"):
                    record["fix_sha"] = fix
                    baseline_save(db, record, owner["id"], "resolved", fix)
                for tid in record["affected"]:
                    if tid == owner["id"] or tid in record["refreshes"]:
                        continue
                    row = get_ticket(db, tid)
                    if not row["worktree"] or row["retired_at"]:
                        continue
                    try:
                        head = baseline_head(row)
                        stale = not baseline_contains(main, fix, head)
                    except Refusal:
                        # Unknown/missing worktrees must not look current.
                        head, stale = None, True
                    if stale:
                        record["refreshes"][tid] = dict(status="requested", old_sha=head)
                        baseline_save(db, record, tid, "requested", record["refreshes"][tid])
            elif op == "recover":
                row = get_ticket(db, args.ticket)
                refresh = record["refreshes"].get(args.ticket)
                if not refresh or not args.stopped or not args.stage_boundary:
                    raise Refusal(EXIT_GATE, "recovery needs a request, --stopped and --stage-boundary")
                evidence = baseline_text(args.evidence, "recovery")
                if row["baseline_refresh"]:
                    try:
                        marker = json.loads(row["baseline_refresh"])
                        if not isinstance(marker, dict) or not isinstance(marker.get("pid"), int) or not marker.get("baseline"):
                            raise ValueError("missing reservation identity")
                    except (ValueError, TypeError):
                        raise Refusal(EXIT_GATE, "invalid refresh reservation; investigate retained state")
                    if marker["baseline"] != args.id:
                        raise Refusal(EXIT_GATE, "another baseline owns the refresh reservation")
                    if (target_exists(marker["pid"], False)
                            and (not marker.get("pid_start") or ps_field(marker["pid"], "lstart") == marker["pid_start"])):
                        raise Refusal(EXIT_GATE, "refresh process still alive; wait for it to exit")
                cleared = dict(row, baseline_refresh=None)
                baseline_idle(db, cleared)
                path = baseline_local(row)
                baseline_clean(path)
                main, base = baseline_base()
                head = baseline_head(row)
                if not baseline_contains(main, record["fix_sha"], base):
                    raise Refusal(EXIT_GATE, "configured base no longer contains the fix")
                integrated = baseline_contains(path, record["fix_sha"], head)
                refresh.update(status="success" if integrated else "requested", new_sha=head,
                               recovery_evidence=evidence)
                refresh.pop("ack_sha", None)
                baseline_invalidate_ci(db, args.ticket)
                db.execute("UPDATE tickets SET baseline_refresh=NULL WHERE id=?", (args.ticket,))
                baseline_save(db, record, args.ticket, "recovered", refresh)
            elif op == "ack":
                row = get_ticket(db, args.ticket)
                baseline_idle(db, row)
                refresh = record["refreshes"].get(args.ticket)
                if not refresh or refresh["status"] != "success":
                    raise Refusal(EXIT_GATE, "ack requires a successful refresh")
                head = baseline_head(row)
                baseline_clean(row["worktree"])
                if not baseline_contains(row["worktree"], record["fix_sha"], head):
                    raise Refusal(EXIT_GATE, "current HEAD no longer contains the baseline fix")
                if args.sha != head:
                    raise Refusal(EXIT_GATE, "tests and independent review must cover current HEAD")
                refresh.update(ack_sha=head, tests=baseline_text(args.tests, "tests"),
                               review=baseline_text(args.review, "review"))
                baseline_save(db, record, args.ticket, "ack", refresh)
        emit(args, record, json.dumps(record, sort_keys=True))


cmd_baseline.own_tx = True


def baseline_refresh(args, db):
    failure = None
    with transaction(db):
        record = baseline_get(db, args.id)
        row = get_ticket(db, args.ticket)
        refresh = record["refreshes"].get(args.ticket)
        if not refresh:
            raise Refusal(EXIT_GATE, "no refresh requested for this ticket")
        try:
            if row["retired_at"] or row["phase"] == "done":
                raise Refusal(EXIT_GATE, "cannot refresh a done or retired ticket")
            if not args.stage_boundary:
                raise Refusal(EXIT_GATE, "refresh requires --stage-boundary")
            baseline_idle(db, row)
            path = baseline_local(row)
            baseline_clean(path)
            main, base = baseline_base()
            if not baseline_contains(main, record["fix_sha"], base):
                raise Refusal(EXIT_GATE, "configured base no longer contains the fix")
            head = baseline_head(row)
            if refresh["status"] == "success" and baseline_contains(path, record["fix_sha"], head):
                return emit(args, refresh, "success")
        except Refusal as e:
            failure = e
            # Preserve conflicts and reservations, even after a second refusal.
            if refresh["status"] not in ("conflicted", "success") and not row["baseline_refresh"]:
                refresh["status"] = "guard-refused"
            baseline_save(db, record, args.ticket, "guard-refused", str(e))
        if failure is None:
            token = json.dumps(dict(token=uuid.uuid4().hex, baseline=args.id,
                                    pid=os.getpid(), pid_start=ps_field(os.getpid(), "lstart")))
            db.execute("UPDATE tickets SET baseline_refresh=? WHERE id=?", (token, args.ticket))
            refresh.update(status="refreshing", old_sha=head, base_sha=base)
            baseline_save(db, record, args.ticket, "refreshing", refresh)
    if failure:
        raise failure
    # Durable reservation blocks dispatch without holding SQLite across Git.
    # Interruption/timeout leaves it in place: a surviving Git child is unknown.
    try:
        result = subprocess.run(["git", "-C", path, "-c", "rebase.autoStash=false",
                                 "-c", "rebase.updateRefs=false", "-c", "rerere.enabled=false",
                                 "rebase", "--no-autostash", base],
                                capture_output=True, text=True, timeout=600)
        new_head = baseline_head(row)
        if not result.returncode:
            baseline_clean(path)
            if not baseline_contains(path, base, new_head):
                raise Refusal(EXIT_GATE, "rebase returned without the checked base in HEAD")
    except (OSError, subprocess.TimeoutExpired, Refusal) as e:
        with transaction(db):
            record = baseline_get(db, args.id)
            baseline_save(db, record, args.ticket, "recovery-needed", str(e))
        raise Refusal(EXIT_GATE, "refresh interrupted; reservation retained; recovery needed: %s" % e)
    with transaction(db):
        record = baseline_get(db, args.id)
        refresh = record["refreshes"][args.ticket]
        refresh.update(status="conflicted" if result.returncode else "success", new_sha=new_head,
                       output=result.stdout + result.stderr)
        refresh.pop("ack_sha", None)
        if new_head != head:
            # Keep historical results; a later verdict invalidates each prior SHA.
            baseline_invalidate_ci(db, args.ticket)
        db.execute("UPDATE tickets SET baseline_refresh=NULL WHERE id=? AND baseline_refresh=?",
                   (args.ticket, token))
        baseline_save(db, record, args.ticket, refresh["status"], refresh)
    if result.returncode:
        raise Refusal(EXIT_GATE, "rebase failed; preserve Git state and recover explicitly: " + result.stderr.strip())
    emit(args, refresh, "success; rerun affected tests and independent review")


def baseline_invalidate_ci(db, tid):
    for ci in db.execute("SELECT DISTINCT sha FROM ci_results WHERE ticket=?", (tid,)).fetchall():
        db.execute("INSERT INTO ci_results(ticket,sha,verdict,ts) VALUES (?,?,?,?)",
                   (tid, ci[0], "invalidated", now()))


def cmd_complete_run(args, db, sdir):
    row = get_ticket(db, args.ticket)
    refuse_if_refreshing(row)
    baseline_local(row)
    if os.environ.get("PI_SUBAGENT_CHILD") == "1":
        raise Refusal(EXIT_GATE, "completion must be attested by the ticket orchestrator after the child returns")
    if not args.stopped:
        raise Refusal(EXIT_GATE, "completion requires --stopped attestation for invocation and all child work")
    evidence = baseline_text(args.evidence, "completion")
    run = db.execute("SELECT * FROM runs WHERE seq=? AND ticket=?", (args.run, args.ticket)).fetchone()
    if run is None:
        raise Refusal(EXIT_NOT_FOUND, "run does not belong to this ticket")
    if run["completed_at"]:
        if run["completion_evidence"] != evidence:
            raise Refusal(EXIT_GATE, "run completion is immutable")
    else:
        db.execute("UPDATE runs SET completed_at=?, completion_evidence=? WHERE seq=?",
                   (now(), evidence, args.run))
        log_event(db, args.ticket, "run-completed", row["phase"], row["phase"],
                  json.dumps({"run": args.run, "evidence": evidence}))
    emit(args, dict(db.execute("SELECT * FROM runs WHERE seq=?", (args.run,)).fetchone()), "completed")


# ---- in-flight marker ----------------------------------------------------------
# spawn, resume and retire run platform commands and engines without holding
# the write lock. The `launching` column claims the ticket meanwhile, so a
# second one cannot start on it.

def launch_marker(row):
    try:
        m = json.loads(row["launching"]) if row["launching"] else None
    except ValueError:
        return None
    return m if isinstance(m, dict) else None


def launch_in_progress(row):
    """The ticket's marker while it is live: younger than LAUNCH_MARKER_S and
    its orch process still running. Else None (no marker, or abandoned)."""
    m = launch_marker(row)
    if not m:
        return None
    age = age_s(m.get("at"))
    if age is None or age > LAUNCH_MARKER_S:
        return None
    pid = m.get("pid")
    if not isinstance(pid, int) or isinstance(pid, bool) or not target_exists(pid, False):
        return None
    if m.get("pid_start") and ps_field(pid, "lstart") != m["pid_start"]:
        return None
    return m


def refuse_if_launching(row, tid=None):
    refuse_if_refreshing(row)
    m = launch_in_progress(row)
    if m:
        raise Refusal(EXIT_GATE, "launch in progress for %s: orch pid %s started a %s at"
                      " %s; wait for it to finish (a marker older than %d minutes, or"
                      " whose orch process is gone, is ignored)" % (
                          tid or row["id"], m.get("pid"), m.get("op", "launch"),
                          m.get("at"), LAUNCH_MARKER_S // 60))


def claim_launch(db, row, op):
    """Inside a write transaction: refuse if another launch holds the ticket,
    else claim it. Returns the marker, which only its owner clears."""
    refuse_if_launching(row)
    pid = os.getpid()
    marker = json.dumps({"token": uuid.uuid4().hex, "op": op, "pid": pid,
                         "pid_start": ps_field(pid, "lstart"), "at": now()})
    db.execute("UPDATE tickets SET launching=? WHERE id=?", (marker, row["id"]))
    return marker


def release_launch(db, tid, marker):
    """Best effort, in its own transaction: clear our marker."""
    try:
        with transaction(db):
            db.execute("UPDATE tickets SET launching=NULL WHERE id=? AND launching=?",
                       (tid, marker))
    except sqlite3.Error as e:
        print("orch: warning: could not clear the launch marker of %s: %s" % (tid, e),
              file=sys.stderr)


def emit(args, obj, text):
    if args.json:
        print(json.dumps(obj))
    elif text:
        print(text)


def fmt_ticket(t):
    return "%s\t%s\t%s\t%s\t%s\trounds=%s\tpid=%s\talive=%s%s" % (
        t["id"], t["phase"], t["status"], t["platform"], t["health"],
        t["review_rounds"], t["pid"], "yes" if t["alive"] else "no",
        "\tretired" if t["retired"] else "")


def emit_tickets(args, rows, cfg):
    ts = [ticket_dict(r, cfg, full=False) for r in rows]
    emit(args, {"tickets": ts}, "\n".join(fmt_ticket(t) for t in ts))


def log_path(sdir, tid):
    return os.path.join(sdir, "logs", tid + ".log")


# The orchestration skill is user-invoked only (disable-model-invocation; on
# Codex, agents/openai.yaml), so a fresh ticket session loads it by starting
# its prompt with the harness's own invocation of it.
SKILL_COMMANDS = {"claude": "/orchestration:orchestration", "pi": "/skill:orchestration",
                  "codex": "$orchestration:orchestration"}
SKILL_COMMAND = SKILL_COMMANDS["claude"]


LOCAL_TESTS_CONTEXT = (
    "Verification environment: local-tests\n"
    "Run all project-required automated tests and retain complete passing evidence. "
    "Independent review and exact-head CI are required before merge. "
    "After review passes, go to report without a separate verify, browser or "
    "accessibility stage. Missing, failed or incomplete test evidence is not passing."
)


# Persist policy separately from instructions, which may change between launches.
LOCAL_TESTS_MARKER = "<!-- orch:verify-policy=local-tests -->"

# Frozen compatibility with briefs appended by #46, before policy markers existed.
LEGACY_LOCAL_TESTS_CONTEXT = (
    "Verification environment: local-tests\n"
    "Run all project-required automated tests and retain complete passing evidence. "
    "Independent review and exact-head CI are required before merge. "
    "After review passes, go to report without a separate verify, browser or "
    "accessibility stage. Missing, failed or incomplete test evidence is not passing."
)


def verification_policy(cfg):
    policy = cfg.get("verify_policy", "auto")
    if policy not in ("auto", "local-tests"):
        raise Refusal(EXIT_PREFLIGHT, "invalid verify_policy: expected auto or local-tests")
    return policy


def retained_verification_context(brief):
    """Read launch-time policy from the stored brief, never the current config."""
    text = (brief or "").strip()
    marked = LOCAL_TESTS_MARKER in text.splitlines()
    legacy = text == LEGACY_LOCAL_TESTS_CONTEXT or text.endswith(
        "\n\n" + LEGACY_LOCAL_TESTS_CONTEXT)
    return LOCAL_TESTS_CONTEXT if marked or legacy else ""


def ticket_prompt(brief, harness="claude"):
    return "%s %s" % (SKILL_COMMANDS[harness], brief)


def resume_prompt(tid, harness):
    """The prompt that continues a ticket session. Claude's resumed session
    still holds the skill. Pi and Codex get the skill command again: a session
    killed before its first turn was saved resumes empty, and the skill is
    user-invoked only, so nothing else would load it."""
    text = ("You are resuming work on ticket %s. Your previous session stopped. Run"
            " `orch show %s` first to read the current state, then continue from the"
            " recorded phase." % (tid, tid))
    return text if harness == "claude" else ticket_prompt(text, harness)


def write_prompt(sdir, name, text):
    """The prompt file a session reads its prompt from (headless: stdin)."""
    briefs = os.path.join(sdir, "briefs")
    path = os.path.join(briefs, name)
    try:
        os.makedirs(briefs, exist_ok=True)
        with open(path, "w") as f:
            f.write(text)
    except OSError as e:
        raise Refusal(EXIT_GATE, "cannot write prompt file %s: %s" % (path, e))
    return path


def session_created(sdir, tid, sid, harness="claude"):
    """True if the ticket's headless log shows the session `sid` was created:
    claude's stream-json lines carry `session_id`, pi's JSON mode starts with
    a session header carrying `id`."""
    try:
        with open(log_path(sdir, tid)) as f:
            for line in f:
                if sid not in line:
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(obj, dict):
                    continue
                if harness == "claude" and obj.get("session_id") == sid:
                    return True
                if harness == "pi" and obj.get("type") == "session" \
                        and obj.get("id") == sid:
                    return True
    except OSError:
        pass
    return False


def cannot_start(what, cwd, err):
    return Refusal(EXIT_GATE, "cannot start %s in %s: %s" % (what, cwd, err))


def launch_headless(sdir, tid, cwd, argv, prompt_file, harness="claude"):
    os.makedirs(os.path.join(sdir, "logs"), exist_ok=True)
    binary = harness_bin(harness)
    env = {k: v for k, v in os.environ.items() if k not in LAUNCH_ENV_DROP}
    try:
        with open(log_path(sdir, tid), "ab") as log, open(prompt_file, "rb") as stdin:
            proc = subprocess.Popen(
                [binary] + argv, cwd=cwd, stdin=stdin, stdout=log, stderr=log,
                start_new_session=True, env=env,
            )
    except OSError as e:
        raise cannot_start(binary, cwd, e)
    return proc.pid


class ToolError(Exception):
    def __init__(self, msg, code=None, message=None, reply=None):
        super().__init__(msg)
        self.code = code
        self.message = message or ""
        self.reply = reply


def call_tool(platform, args, timeout=60):
    """Run one orca/herdr command; return its parsed JSON reply (None if it
    printed no JSON). Raises ToolError on a non-zero exit or an error reply:
    herdr exits 0 with a top-level "error"; orca exits 1 with `"ok": false`."""
    binary = platform_bin(platform)
    what = "`%s %s`" % (platform, " ".join(args[:2]))
    try:
        p = subprocess.run([binary] + args, capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        raise ToolError("%s: %s" % (binary, e))
    reply = None
    for stream in (p.stdout, p.stderr):
        try:
            reply = json.loads(stream)
            break
        except ValueError:
            pass
    if p.returncode == 0 and stream is p.stderr:
        reply = None  # a clean exit replies on stdout only
    err = reply.get("error") if isinstance(reply, dict) else None
    if p.returncode != 0 or err or (isinstance(reply, dict) and reply.get("ok") is False):
        code = message = None
        if isinstance(err, dict):
            code, message = err.get("code"), err.get("message")
        elif isinstance(err, str):
            message = err
        detail = message or p.stderr.strip() or p.stdout.strip()
        raise ToolError("%s %s: %s%s" % (
            what, "exited %d" % p.returncode if p.returncode else "failed",
            "[%s] " % code if code else "", str(detail)[:300]),
            code=code, message=message, reply=reply)
    return reply


def call_tool_json(platform, args, timeout=60):
    reply = call_tool(platform, args, timeout)
    if not isinstance(reply, dict):
        raise ToolError("`%s %s` did not reply with a JSON object"
                        % (platform, " ".join(args[:2])))
    return reply


def first_string(node, key):
    """The first non-empty string value under a key named `key`, depth first."""
    found = all_strings(node, key)
    return found[0] if found else None


def all_strings(node, key):
    """Every non-empty string value under a key named `key`, depth first."""
    out = []
    if isinstance(node, dict):
        for k, v in node.items():
            if k == key and isinstance(v, str) and v:
                out.append(v)
            else:
                out.extend(all_strings(v, key))
    elif isinstance(node, list):
        for v in node:
            out.extend(all_strings(v, key))
    return out


def dig(node, *keys):
    for k in keys:
        if not isinstance(node, dict):
            return None
        node = node.get(k)
    if isinstance(node, (str, int)) and not isinstance(node, bool) and node != "":
        return str(node)
    return None


def realpath_or_none(path):
    return os.path.realpath(path) if isinstance(path, str) and path else None


# ---- worktree engines --------------------------------------------------------

def engine_command(kind, main):
    """(argv prefix, env) for the create/retire engine: the main checkout's
    own shim when it has one (pointed at the engine), else the engine."""
    engine = (os.environ.get("ORCH_%s_ENGINE" % kind.upper())
              or BUNDLED_ENGINES[kind])
    shim = os.path.join(main, "scripts", "setup-worktree.sh" if kind == "create"
                        else "retire-worktree.sh")
    env = dict(os.environ)
    if os.path.isfile(shim) and os.access(shim, os.X_OK):
        env["WORKTREE_ENGINE" if kind == "create" else "RETIRE_ENGINE"] = engine
        return [shim], env
    return [engine], env


def run_engine(kind, main, args, cwd, extra_env=None):
    """Run an engine, echoing its output on stderr. Returns (exit code, the
    last lines of its output)."""
    argv, env = engine_command(kind, main)
    env.update(extra_env or {})
    try:
        p = subprocess.Popen(argv + args, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             text=True, errors="replace")
    except OSError as e:
        return 127, "%s: %s" % (argv[0], e)
    tail = collections.deque(maxlen=12)
    for line in p.stdout:
        sys.stderr.write(line)
        tail.append(line.rstrip("\n"))
    p.wait()
    return p.returncode, "\n".join(tail)


def worktree_name(tid):
    """Directory and branch name of a ticket's worktree: the ticket id, in the
    engines' alphabet (lowercase letters, digits and hyphens)."""
    return re.sub(r"[^a-z0-9-]+", "-", tid.lower()).strip("-") or "ticket"


def git_lines(*args):
    p = subprocess.run(["git"] + list(args), capture_output=True, text=True)
    return p.stdout.splitlines() if p.returncode == 0 else []


def git_worktrees(main):
    return [os.path.realpath(l[len("worktree "):])
            for l in git_lines("-C", main, "worktree", "list", "--porcelain")
            if l.startswith("worktree ")]


def git_branches(main):
    return set(git_lines("-C", main, "branch", "--list", "--format=%(refname:short)"))


def git_branch_of(path):
    lines = git_lines("-C", path, "symbolic-ref", "--quiet", "--short", "HEAD")
    return lines[0].strip() if lines else None


def cannot_create(tid, err):
    return Refusal(EXIT_GATE, "cannot create a worktree for %s: %s" % (tid, err))


def create_worktree(platform, tid):
    """Make and provision the ticket's worktree from BASE_BRANCH. Returns
    (realpath, worktree_ref or None); refuses (exit 3) leaving nothing behind."""
    main = main_checkout()
    base, orch_file = base_branch()
    if not base:
        raise cannot_create(tid, "BASE_BRANCH is not set in %s" % orch_file)
    name = worktree_name(tid)
    if platform == "orca":
        return orca_create_worktree(main, tid, name, base)
    before, branches = set(git_worktrees(main)), git_branches(main)
    rc, tail = run_engine("create", main, [name], main, {"BASE_BRANCH": base})
    # Only the worktree this call asked for, and only if it is new: the
    # launch marker keeps another spawn of the same name from racing us.
    new = [w for w in git_worktrees(main)
           if w not in before and os.path.basename(w) == name]
    if rc != 0:
        if len(new) == 1:  # a half-made worktree (provisioning failed)
            discard_engine_worktree(main, new[0], name not in branches)
        raise cannot_create(tid, "create-worktree exited %d: %s" % (rc, tail))
    if len(new) != 1:
        raise cannot_create(tid, "create-worktree succeeded but no new worktree named"
                            " %s appeared" % name)
    return new[0], None


def discard_engine_worktree(main, path, branch_is_new):
    """Best effort: undo a worktree orch just made with the create engine."""
    if branch_is_new:
        run_engine("retire", main, [os.path.basename(path), "--force"], main)
    if os.path.isdir(path):
        subprocess.run(["git", "-C", main, "worktree", "remove", "--force", path],
                       capture_output=True)


def orca_create_worktree(main, tid, name, base):
    args = ["worktree", "create", "--repo", "path:" + main, "--name", name,
            "--no-parent", "--base-branch", base, "--setup", "skip", "--json"]
    try:
        try:
            reply = call_tool_json("orca", args, timeout=300)
        except ToolError as e:
            if e.code not in ("selector_not_found", "repo_not_found"):
                raise
            # The repo is not registered with Orca yet: add it, retry once.
            call_tool_json("orca", ["repo", "add", "--path", main, "--json"])
            reply = call_tool_json("orca", args, timeout=300)
    except ToolError as e:
        raise cannot_create(tid, e)
    path = realpath_or_none(dig(reply, "result", "worktree", "path"))
    wid = dig(reply, "result", "worktree", "id")
    if not path or not os.path.isdir(path):
        raise cannot_create(tid, "orca reply names no worktree path: %s"
                            % json.dumps(reply)[:200])
    ref = {"orca_worktree": wid} if wid else None
    rc, tail = run_engine("create", main, ["--provision"], path, {"BASE_BRANCH": base})
    if rc != 0:
        try:
            call_tool("orca", ["worktree", "rm", "--worktree", orca_selector(path, ref),
                               "--force", "--json"], timeout=120)
        except ToolError:
            pass
        raise cannot_create(tid, "create-worktree --provision exited %d: %s" % (rc, tail))
    return path, ref


def orca_selector(path, wref):
    if wref and wref.get("orca_worktree"):
        return "id:" + wref["orca_worktree"]
    return "path:" + path


def remove_worktree(platform, tid, worktree, wref, force):
    """Delete the ticket's DDEV project, checkout and branch. Refuses (exit 3)
    when the engine refuses, e.g. uncommitted work without `force`."""
    if not worktree or not os.path.isdir(worktree):
        return
    main = main_checkout()
    args = [os.path.basename(worktree)]
    if platform == "orca":
        args.append("--ddev-only")  # Orca removes the checkout and branch itself
    if force:
        args.append("--force")
    rc, tail = run_engine("retire", main, args, main)
    if rc != 0:
        raise Refusal(EXIT_GATE, "cannot remove the worktree of %s (%s): retire-worktree"
                      " exited %d: %s" % (tid, worktree, rc, tail))
    if platform == "orca":
        try:
            call_tool("orca", ["worktree", "rm", "--worktree", orca_selector(worktree, wref),
                               "--force", "--json"], timeout=120)
        except ToolError as e:
            raise Refusal(EXIT_GATE, "cannot remove the worktree of %s (%s): %s"
                          % (tid, worktree, e))


def row_worktree_ref(row):
    try:
        ref = json.loads(row["worktree_ref"]) if row["worktree_ref"] else None
    except ValueError:
        return None
    return ref if isinstance(ref, dict) else None


# ---- platform adapters: launch, close, visible -------------------------------

def herdr_agent_name(tid):
    """Herdr agent names match [a-z][a-z0-9_-]{0,31}."""
    return ("t" + re.sub(r"[^a-z0-9_-]", "-", tid.lower()))[:32]


def session_flags(harness, session):
    """The flags that start (`mode` start) or continue (resume) the session
    `sid`. Claude and Pi take a session id we choose; Codex picks its own, so a
    start names none and a resume is a subcommand (see agent_argv)."""
    mode, sid = session["mode"], session["sid"]
    if harness == "claude":
        return ["--resume" if mode == "resume" else "--session-id", sid]
    if harness == "pi":
        return ["--session-id", sid]  # opens the session, or creates it
    return []


def headless_argv(harness, session, args):
    if harness == "claude":
        return (["-p"] + session_flags(harness, session)
                + ["--output-format", "stream-json", "--verbose"] + args)
    if harness == "pi":
        return ["-p", "--mode", "json"] + session_flags(harness, session) + args
    if session["mode"] == "resume":
        return ["exec", "resume", "--json"] + args + [session["sid"], "-"]
    return ["exec", "--json"] + args + ["-"]


def agent_argv(harness, session, args):
    """Arguments of an interactive session (orca, herdr), prompt excluded."""
    if harness == "codex":
        if session["mode"] == "resume":
            return ["resume"] + args + [session["sid"]]
        return list(args)
    return session_flags(harness, session) + args


def interactive_cmd(harness, session, args, prompt_file):
    cmd = " ".join(shlex.quote(a) for a in
                   [harness_bin(harness)] + agent_argv(harness, session, args))
    return cmd + ' "$(cat %s)"' % shlex.quote(prompt_file)


def orca_launch(tid, worktree, harness, session, args, prompt_file):
    reply = call_tool_json("orca", [
        "terminal", "create", "--worktree", "path:" + worktree, "--title", "t" + tid,
        "--command", interactive_cmd(harness, session, args, prompt_file), "--json"])
    handle = first_string(reply, "handle")
    if not handle:
        # A terminal may be running without a handle to name it: close them all.
        try:
            call_tool("orca", ["terminal", "close", "--worktree", "path:" + worktree,
                               "--all", "--json"])
        except ToolError:
            pass
        raise ToolError("orca reply has no terminal handle: %s" % json.dumps(reply)[:200])
    return {"terminal": handle}, orca_trust_blocked(handle, worktree, harness)


def orca_trust_blocked(handle, worktree, harness="claude"):
    """Orca reports claude stopped at the folder-trust dialog as blockedReason
    "agent-trust-workspace" when waiting for the TUI to go idle."""
    try:
        reply = call_tool("orca", [
            "terminal", "wait", "--terminal", handle, "--for", "tui-idle",
            "--timeout-ms", str(ORCA_TRUST_WAIT_MS), "--json"],
            timeout=ORCA_TRUST_WAIT_MS / 1000.0 + 15)
    except ToolError as e:
        reply = e.reply
    reason = first_string(reply, "blockedReason") or ""
    return TRUST_MSG % (harness, worktree) if "trust" in reason.lower() else None


def herdr_launch(tid, worktree, harness, session, args, prompt_file):
    main = main_checkout()
    agent = herdr_agent_name(tid)
    with open(prompt_file) as f:
        prompt = f.read()
    reply = call_tool_json("herdr", [
        "worktree", "open", "--cwd", main, "--path", worktree, "--label", "t" + tid,
        "--no-focus"])
    ws = dig(reply, "result", "workspace", "workspace_id")
    pane = dig(reply, "result", "root_pane", "pane_id")
    result = reply.get("result") if isinstance(reply.get("result"), dict) else {}
    ours = result.get("already_open") is not True

    def drop(agent_started=False):
        if ws and ours:
            platform_close("herdr", {"workspace": ws}, worktree)
        elif agent_started and pane:
            # Not our workspace: stop just the agent (herdr has no `agent
            # stop`), by closing the pane it runs in.
            try:
                call_tool("herdr", ["pane", "close", pane])
            except ToolError:
                pass

    if not ws or not pane:
        drop()
        raise ToolError("herdr reply lacks workspace or root pane id: %s"
                        % json.dumps(reply)[:200])
    ref = {"workspace": ws, "pane": pane, "agent": agent}
    trust = (TRUST_MSG % (harness, worktree) + "; once accepted, send the prompt with"
             " `herdr agent prompt %s \"$(cat %s)\"`" % (agent, shlex.quote(prompt_file)))
    try:
        call_tool("herdr", ["agent", "start", agent, "--kind", harness, "--pane", pane,
                            "--"] + agent_argv(harness, session, args), timeout=120)
    except ToolError as e:
        if e.code == "agent_not_ready" and herdr_at_trust(agent, e):
            return ref, trust
        drop(agent_started=e.code == "agent_not_ready")
        raise
    try:
        call_tool("herdr", ["agent", "prompt", agent, prompt])
    except ToolError as e:
        if e.code in ("agent_blocked", "agent_not_ready") and herdr_at_trust(agent, e):
            return ref, trust
        drop(agent_started=True)
        raise
    return ref, None


def herdr_at_trust(agent, err):
    """Herdr says only that the agent is blocked, not by what: the folder-trust
    dialog is the block when the error or the agent's screen mentions trust."""
    if "trust" in ("%s %s" % (err.message, err)).lower():
        return True
    try:
        p = subprocess.run([platform_bin("herdr"), "agent", "read", agent, "--source",
                            "visible"], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return False
    return p.returncode == 0 and "trust" in p.stdout.lower()


def platform_close(platform, ref, worktree):
    """Best effort: close the terminal/workspace a launch_ref names. Returns
    (attempted, error message or None)."""
    ref = ref or {}
    if platform == "orca" and ref.get("terminal") and worktree:
        args = ["terminal", "close", "--worktree", "path:" + worktree, "--all", "--json"]
    elif platform == "herdr" and ref.get("workspace"):
        args = ["workspace", "close", ref["workspace"]]
    else:
        return False, None
    try:
        call_tool(platform, args)
    except ToolError as e:
        return True, str(e)
    return True, None


def visible(platform, row):
    """Whether the platform shows the ticket's worktree and session natively:
    True, False, or None (unknown: the platform command failed)."""
    wt, ref = row["worktree"], row_launch_ref(row) or {}
    detail = []
    if platform == "headless":
        return {"worktree": bool(wt) and os.path.isdir(wt), "session": row_alive(row),
                "detail": "pid %s" % row["pid"]}
    if platform == "orca":
        try:
            paths = all_strings(call_tool_json("orca", ["worktree", "list", "--json"]),
                                "path")
            in_wt = bool(wt) and wt in {os.path.realpath(p) for p in paths}
        except ToolError as e:
            in_wt = None
            detail.append(str(e))
        try:
            handles = all_strings(call_tool_json(
                "orca", ["terminal", "list", "--worktree", "path:%s" % wt, "--json"]),
                "handle")
            session = bool(ref.get("terminal")) and ref["terminal"] in handles
        except ToolError as e:
            # No such worktree any more: then no terminal in it either.
            session = False if e.code == "selector_not_found" else None
            detail.append(str(e))
        return {"worktree": in_wt, "session": session, "detail": "; ".join(detail)}
    if platform == "herdr":
        agent = ref.get("agent") or herdr_agent_name(row["id"])
        try:
            reply = call_tool_json("herdr", ["agent", "get", agent])
            session = True
            detail.append("agent %s: %s" % (agent, first_string(reply, "agent_status")))
        except ToolError as e:
            session = False if e.code == "agent_not_found" else None
            detail.append(str(e))
        try:
            reply = call_tool_json("herdr", ["worktree", "list", "--cwd", main_checkout()])
            entries = (reply.get("result") or {}).get("worktrees") or []
            in_wt = any(isinstance(e, dict) and e.get("open_workspace_id")
                        and realpath_or_none(e.get("path")) == wt for e in entries)
        except (ToolError, AttributeError) as e:
            in_wt = None
            detail.append(str(e))
        return {"worktree": in_wt, "session": session, "detail": "; ".join(detail)}
    raise Refusal(EXIT_USAGE, "visible() on %s needs the main orchestrator" % platform)


def herdr_main_workspace(main):
    """Id of the open Herdr workspace whose checkout is the main checkout, or
    None. Raises ToolError when herdr cannot tell."""
    reply = call_tool_json("herdr", ["workspace", "list"])
    stack = [reply]
    while stack:
        node = stack.pop()
        if isinstance(node, list):
            stack.extend(node)
        elif isinstance(node, dict):
            wt = node.get("worktree")
            if node.get("workspace_id") and isinstance(wt, dict) \
                    and realpath_or_none(wt.get("checkout_path")) == main:
                return node["workspace_id"]
            stack.extend(node.values())
    return None


# ---- folder trust in Claude's user config ------------------------------------

class TrustError(Exception):
    """Claude's user config could not be read or written. Messages never carry
    the file's contents."""


def claude_json_path():
    override = os.environ.get("ORCH_CLAUDE_JSON")
    if override:
        return override
    base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~")
    return os.path.join(base, ".claude.json")


def read_claude_json_sig(path):
    """(config, signature) where the signature (inode, mtime_ns, size) is of
    the file just read, for spotting a concurrent rewrite before replacing."""
    try:
        with open(path, encoding="utf-8") as f:
            st = os.fstat(f.fileno())
            text = f.read()
    except FileNotFoundError:
        raise TrustError("%s does not exist" % path)
    except OSError as e:
        raise TrustError("cannot read %s: %s" % (path, e.strerror))
    except ValueError:
        raise TrustError("%s is not valid UTF-8" % path)
    try:
        data = json.loads(text)
    except ValueError:
        raise TrustError("%s is not valid JSON" % path)
    if not isinstance(data, dict):
        raise TrustError("%s is not a JSON object" % path)
    projects = data.get("projects")
    if projects is not None and not isinstance(projects, dict):
        raise TrustError("%s has a \"projects\" that is not an object" % path)
    return data, file_sig(st)


def read_claude_json(path):
    return read_claude_json_sig(path)[0]


def file_sig(st):
    return (st.st_ino, st.st_mtime_ns, st.st_size)


class ConfigChanged(Exception):
    """The config changed between our read and our replace."""


def write_claude_json(path, data, expect=None):
    """Replace the file `path` names (through a symlink, so a link stays a
    link) atomically, keeping its mode. With `expect`, a signature from
    read_claude_json_sig, raise ConfigChanged instead of replacing a file
    rewritten since that read."""
    target = os.path.realpath(path)
    try:
        mode = os.stat(target).st_mode & 0o7777
        fd, tmp = tempfile.mkstemp(prefix=".claude.json.orch-",
                                   dir=os.path.dirname(target))
    except OSError as e:
        raise TrustError("cannot write %s: %s" % (path, e.strerror))
    replaced = False
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.flush()
            os.fchmod(f.fileno(), mode)
            os.fsync(f.fileno())
        if expect is not None and file_sig(os.stat(target)) != expect:
            raise ConfigChanged()
        os.replace(tmp, target)
        replaced = True
    except OSError as e:
        raise TrustError("cannot write %s: %s" % (path, e.strerror))
    finally:
        if not replaced:
            try:
                os.remove(tmp)
            except OSError:
                pass


def is_trusted(path):
    """Whether Claude's user config trusts exactly `path`. Raises TrustError."""
    data = read_claude_json(claude_json_path())
    entry = (data.get("projects") or {}).get(path)
    return isinstance(entry, dict) and entry.get(TRUST_KEY) is True


def set_trust(path, want, whole_entry=False):
    """Mark (`want`) or unmark `path` as trusted in Claude's user config.
    Claude processes rewrite the file concurrently: the replace is skipped
    when the file changed since it was read, and the change is re-read after
    each write; either retries. Marking returns 0 when it was already
    trusted, 1 when the key was added to an existing entry, 2 when the entry
    was created. Unmarking pops the key; with `whole_entry` it removes the
    entry when that is still exactly the one orch created.
    A missing or invalid file is never created or overwritten: TrustError."""
    cfg = claude_json_path()
    added = None
    for attempt in range(TRUST_WRITES + 1):
        data, sig = read_claude_json_sig(cfg)
        projects = data.get("projects")
        if projects is None:
            projects = {}
        entry = projects.get(path)
        if want:
            done = isinstance(entry, dict) and entry.get(TRUST_KEY) is True
        else:
            done = not (isinstance(entry, dict) and TRUST_KEY in entry)
        if done:
            return added or 0
        if attempt == TRUST_WRITES:
            break
        if attempt:
            time.sleep(0.05 * 2 ** attempt)
        if want:
            new = 1 if isinstance(entry, dict) else 2
            if not isinstance(entry, dict):
                entry = projects[path] = {}
            entry[TRUST_KEY] = True
            data["projects"] = projects
        elif whole_entry and entry == {TRUST_KEY: True}:
            del projects[path]
        else:
            entry.pop(TRUST_KEY)
        try:
            write_claude_json(cfg, data, expect=sig)
        except ConfigChanged:
            continue
        if want:
            added = new
    raise TrustError("another process kept rewriting %s; gave up after %d writes"
                     % (cfg, TRUST_WRITES))


def codex_home():
    return os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")


def codex_toml_key(path):
    return '"%s"' % path.replace("\\", "\\\\").replace('"', '\\"')


def codex_trust_block(path):
    return '[projects.%s]\ntrust_level = "trusted"\n' % codex_toml_key(path)


def codex_has_project(text, path):
    """Whether config.toml text has a projects table for `path`, in either
    quoting Codex accepts."""
    keys = (re.escape(codex_toml_key(path)), re.escape("'%s'" % path))
    return re.search(r"(?m)^\s*\[\s*projects\s*\.\s*(?:%s)\s*\]\s*$" % "|".join(keys),
                     text) is not None


def set_codex_trust(path, want):
    """Add (`want`) the table that trusts `path` to Codex's config.toml, only
    when the file has no table for `path` yet, or remove exactly the table orch
    added. Returns whether the file changed. Like set_trust, the replace is
    skipped and retried when Codex rewrote the file since it was read. A
    missing file is created by marking. Raises TrustError."""
    cfg = os.path.join(codex_home(), "config.toml")
    for attempt in range(TRUST_WRITES + 1):
        try:
            with open(cfg, encoding="utf-8") as f:
                sig = file_sig(os.fstat(f.fileno()))
                text = f.read()
        except FileNotFoundError:
            sig, text = None, ""
        except (OSError, ValueError) as e:
            raise TrustError("cannot read %s: %s" % (cfg, getattr(e, "strerror", e)))
        block = codex_trust_block(path)
        if want:
            if codex_has_project(text, path):
                return False
            new = text + ("\n" if text and not text.endswith("\n") else "") \
                + ("\n" if text else "") + block
        else:
            i = text.find(block)
            if i < 0 or (i and text[i - 1] != "\n"):
                return False
            head = text[:i]
            if head.endswith("\n\n"):
                head = head[:-1]
            new = head + text[i + len(block):]
        if attempt == TRUST_WRITES:
            break
        if attempt:
            time.sleep(0.05 * 2 ** attempt)
        try:
            write_text_atomic(cfg, new, expect=sig)
        except ConfigChanged:
            continue
        return True
    raise TrustError("another process kept rewriting %s; gave up after %d writes"
                     % (cfg, TRUST_WRITES))


def write_text_atomic(path, text, expect=None):
    """write_claude_json for a text file; a missing file (expect None) is created."""
    target = os.path.realpath(path)
    try:
        mode = os.stat(target).st_mode & 0o7777 if expect is not None else 0o600
        os.makedirs(os.path.dirname(target), exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".config.toml.orch-",
                                   dir=os.path.dirname(target))
    except OSError as e:
        raise TrustError("cannot write %s: %s" % (path, e.strerror))
    replaced = False
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fchmod(f.fileno(), mode)
            os.fsync(f.fileno())
        if expect is None:
            if os.path.exists(target):
                raise ConfigChanged()
        elif file_sig(os.stat(target)) != expect:
            raise ConfigChanged()
        os.replace(tmp, target)
        replaced = True
    except FileNotFoundError:
        raise ConfigChanged()
    except OSError as e:
        raise TrustError("cannot write %s: %s" % (path, e.strerror))
    finally:
        if not replaced:
            try:
                os.remove(tmp)
            except OSError:
                pass


def same_worktree_tickets(db, tid, wt):
    """Non-retired tickets other than `tid` whose worktree is `wt` (a realpath)."""
    return [r for r in db.execute(
        "SELECT * FROM tickets WHERE id<>? AND retired_at IS NULL"
        " AND worktree IS NOT NULL ORDER BY seq", (tid,)).fetchall()
        if os.path.realpath(r["worktree"]) == wt]


def mark_ticket_trust(db, row):
    """Before an orca/herdr launch: trust the ticket worktree so interactive
    claude (or codex) does not stop at the folder-trust dialog. Failure only
    warns. Returns the trust_mark event's seq when orch added the trust, else
    None."""
    if row_harness(row) == "codex":
        return mark_codex_trust(db, row)
    if row_harness(row) != "claude":
        return None
    tid, wt = row["id"], os.path.realpath(row["worktree"])
    if any(r["trust_marked"] for r in same_worktree_tickets(db, tid, wt)):
        # Another ticket on this worktree holds the trust orch added.
        return None
    try:
        added = set_trust(wt, True)
    except TrustError as e:
        print("orch: warning: could not mark %s trusted for claude: %s; claude may"
              " stop at the folder-trust prompt" % (wt, e), file=sys.stderr)
        return None
    if not added:
        return None
    with transaction(db):
        db.execute("UPDATE tickets SET trust_marked=MAX(trust_marked, ?) WHERE id=?",
                   (added, tid))
        return log_event(db, tid, "trust_mark", row["phase"], row["phase"], wt)


def mark_codex_trust(db, row):
    tid, wt = row["id"], os.path.realpath(row["worktree"])
    if any(r["trust_codex"] for r in same_worktree_tickets(db, tid, wt)):
        return None
    try:
        added = set_codex_trust(wt, True)
    except TrustError as e:
        print("orch: warning: could not mark %s trusted for codex: %s; codex may"
              " stop at the folder-trust prompt" % (wt, e), file=sys.stderr)
        return None
    if not added:
        return None
    with transaction(db):
        db.execute("UPDATE tickets SET trust_codex=1 WHERE id=?", (tid,))
        return log_event(db, tid, "trust_mark", row["phase"], row["phase"],
                         "codex " + wt)


def unmark_codex_trust(db, tid, worktree, log=True):
    row = get_ticket(db, tid)
    if not row["trust_codex"] or not worktree:
        return True
    wt = os.path.realpath(worktree)
    others = same_worktree_tickets(db, tid, wt)
    if others:
        with transaction(db):
            db.execute("UPDATE tickets SET trust_codex=1 WHERE id=?", (others[0]["id"],))
            db.execute("UPDATE tickets SET trust_codex=0 WHERE id=?", (tid,))
        return True
    try:
        set_codex_trust(wt, False)
    except TrustError as e:
        print("orch: warning: could not remove the folder trust orch added for %s"
              " from codex's config: %s" % (wt, e), file=sys.stderr)
        return False
    with transaction(db):
        db.execute("UPDATE tickets SET trust_codex=0 WHERE id=?", (tid,))
        if log:
            log_event(db, tid, "trust_unmark", row["phase"], row["phase"],
                      "codex " + wt)
    return True


def unmark_ticket_trust(db, tid, worktree, log=True):
    """Remove the folder trust orch added for the ticket (Claude's and
    Codex's), if any. Failure only warns. Returns whether no trust orch added
    is left."""
    codex_ok = unmark_codex_trust(db, tid, worktree, log)
    return unmark_claude_trust(db, tid, worktree, log) and codex_ok


def unmark_claude_trust(db, tid, worktree, log=True):
    row = get_ticket(db, tid)
    marked = row["trust_marked"]
    if not marked or not worktree:
        return True
    wt = os.path.realpath(worktree)
    others = same_worktree_tickets(db, tid, wt)
    if others:
        # Still in use by another ticket: hand it the marker instead.
        with transaction(db):
            db.execute("UPDATE tickets SET trust_marked=MAX(trust_marked, ?) WHERE id=?",
                       (marked, others[0]["id"]))
            db.execute("UPDATE tickets SET trust_marked=0 WHERE id=?", (tid,))
        return True
    try:
        set_trust(wt, False, whole_entry=marked == 2)
    except TrustError as e:
        print("orch: warning: could not remove the folder trust orch added for %s: %s"
              % (wt, e), file=sys.stderr)
        return False
    with transaction(db):
        db.execute("UPDATE tickets SET trust_marked=0 WHERE id=?", (tid,))
        if log:
            log_event(db, tid, "trust_unmark", row["phase"], row["phase"], wt)
    return True


class TrustBlocked(Refusal):
    """claude stopped at the folder-trust dialog; the launch is recorded."""

    def __init__(self, msg):
        super().__init__(EXIT_GATE, msg)


def harness_args(harness, cfg):
    key = HARNESS_ARGS[harness]
    return [str(a) for a in cfg.get(key, DEFAULT_CONFIG[key])]


def start_session(platform, sdir, row, session, cfg, prompt_file):
    """Step 2 of a launch on headless/orca/herdr. Returns (pid, launch_ref,
    trust message or None)."""
    tid, worktree, harness = row["id"], row["worktree"], row_harness(row)
    args = harness_args(harness, cfg)
    if platform == "headless":
        pid = launch_headless(sdir, tid, worktree, headless_argv(harness, session, args),
                              prompt_file, harness)
        return pid, {"pid": pid}, None
    what = "%s session" % platform
    if not os.path.isdir(worktree):
        raise cannot_start(what, worktree, "worktree does not exist")
    launch = orca_launch if platform == "orca" else herdr_launch
    try:
        ref, blocked = launch(tid, worktree, harness, session, args, prompt_file)
    except (ToolError, OSError) as e:
        raise cannot_start(what, worktree, e)
    return None, ref, blocked


# Columns a launch's step 1 may change; a failed step 2 restores them all.
LAUNCH_COLUMNS = ("phase", "prior_phase", "platform", "pid", "pid_start",
                  "session_id", "worktree", "attempt", "brief", "activity",
                  "session_seen", "launch_ref", "launched_at", "worktree_ref", "harness")


def log_picked_up(db, tid):
    attempt = get_ticket(db, tid)["attempt"]
    state_md_log(tid, "picked up" + (": attempt %d" % attempt if attempt > 1 else ""))


def finish_launch(db, sdir, cfg, row, evs, platform, session, prompt_file,
                  desktop_action, marker):
    """Steps 2 and 3 of `spawn`/`resume` (step 1 is already committed; `row`
    is the ticket as it was before it). Clears `marker` whatever happens.
    Returns (output, is_action)."""
    try:
        result = launch_steps(db, sdir, cfg, row, evs, platform, session,
                              prompt_file, desktop_action, marker)
        log_picked_up(db, row["id"])
        return result
    except TrustBlocked:
        log_picked_up(db, row["id"])  # the session started behind the dialog
        raise
    finally:
        release_launch(db, row["id"], marker)


def launch_steps(db, sdir, cfg, row, evs, platform, session, prompt_file,
                 desktop_action, marker):
    tid = row["id"]
    cur = get_ticket(db, tid)
    old_platform, old_ref = row_platform(row), row_launch_ref(row)
    closed_old = False
    if desktop_action == "desktop_resume":
        attempted, err = platform_close(old_platform, old_ref, row["worktree"])
        closed_old = attempted and err is None
    if platform == "desktop":
        # Only a Desktop session ref survives onto Desktop.
        ref = old_ref if old_platform == "desktop" and (old_ref or {}).get("desktop") \
            else None
        with transaction(db):
            db.execute("UPDATE tickets SET launch_ref=?, launching=NULL WHERE id=?"
                       " AND launching=?", (json.dumps(ref) if ref else None, tid, marker))
        out = {"action": desktop_action, "cwd": cur["worktree"],
               "prompt_file": prompt_file, "title": "t" + tid}
        if desktop_action == "desktop_resume" and ref:
            out["ref"] = ref["desktop"]
        return out, True
    mark_ev = None
    if platform in ("orca", "herdr") \
            and cur["worktree"] and os.path.isdir(cur["worktree"]):
        mark_ev = mark_ticket_trust(db, cur)
    try:
        pid, ref, blocked = start_session(platform, sdir, cur, session, cfg,
                                          prompt_file)
    except Refusal:
        # Undo the trust this launch added; its event goes with the others
        # unless the trust could not be removed.
        evs = list(evs)
        if mark_ev is not None and unmark_ticket_trust(db, tid, cur["worktree"],
                                                       log=False):
            evs.append(mark_ev)
        # Restore step 1, except a launch_ref naming the terminal/workspace
        # just closed: that one is gone.
        old = [None if c == "launch_ref" and closed_old else row[c]
               for c in LAUNCH_COLUMNS]
        with transaction(db):
            db.execute("UPDATE tickets SET %s, launching=NULL WHERE id=?" % ", ".join(
                "%s=?" % c for c in LAUNCH_COLUMNS), old + [tid])
            db.executemany("DELETE FROM events WHERE seq=?", [(e,) for e in evs])
        raise
    # Pi rewrites its process title and Codex is told its session id only
    # after it starts, so neither command line names the session: their
    # liveness needs the start time from the outset.
    pid_start = ps_field(pid, "lstart") if pid and row_harness(cur) != "claude" else None
    with transaction(db):
        # orca/herdr have no pid here; the SessionStart hook may already have
        # recorded the session's during step 2: keep it.
        db.execute("UPDATE tickets SET pid=COALESCE(?, pid), pid_start=CASE WHEN ? IS NOT"
                   " NULL THEN ? WHEN ? IS NULL OR pid IS ? THEN pid_start ELSE NULL END,"
                   " launch_ref=?, launching=NULL WHERE id=?",
                   (pid, pid_start, pid_start, pid, pid, json.dumps(ref), tid))
        if blocked:
            log_event(db, tid, "trust_prompt", cur["phase"], cur["phase"], blocked)
        t = ticket_dict(get_ticket(db, tid), cfg)
    if blocked:
        raise TrustBlocked(blocked)
    return t, False


# ---- commands --------------------------------------------------------------


def cmd_init(args):
    sdir = state_dir()
    os.makedirs(sdir, exist_ok=True)
    db = connect(sdir)
    try:
        state_md_sync(db)
    finally:
        db.close()
    emit(args, {"state_dir": sdir}, "initialized %s" % sdir)


def cmd_preflight(args):
    main = main_checkout()
    sdir = state_dir()
    cfg = load_config(sdir)
    platform = resolve_platform()
    failures = []
    base, orch_file = base_branch()
    if not base:
        failures.append("BASE_BRANCH is not set in %s" % orch_file)
    policy = verification_policy(cfg)
    verify_env = None
    has_ddev_cfg = os.path.exists(os.path.join(main, ".ddev", "config.yaml"))
    if policy == "local-tests":
        verify_env = "local-tests"
    elif has_ddev_cfg and shutil.which("ddev"):
        verify_env = "ddev"
    elif cfg.get("verify_harness") and shutil.which("docker"):
        verify_env = "docker"
    else:
        failures.append(
            "no verification environment: need .ddev/config.yaml with ddev on PATH"
            " (config.yaml %s, ddev %s), or config.json verify_harness with docker"
            " on PATH (verify_harness %s, docker %s)" % (
                "present" if has_ddev_cfg else "missing",
                "found" if shutil.which("ddev") else "not found",
                "set" if cfg.get("verify_harness") else "unset",
                "found" if shutil.which("docker") else "not found"))
    binary = platform_bin(platform)
    if binary and not shutil.which(binary):
        failures.append("platform %s needs `%s` on PATH (not found)" % (platform, binary))
    harness, source = resolve_harness()
    if harness != "claude" and not shutil.which(harness_bin(harness)):
        failures.append("harness %s needs `%s` on PATH (not found)"
                        % (harness, harness_bin(harness)))
    if platform == "desktop" and harness != "claude":
        failures.append("desktop hosts Claude sessions only, not %s" % harness)
    if failures:
        raise Refusal(EXIT_PREFLIGHT, "preflight failed:\n" +
                      "\n".join("- " + f for f in failures))
    out = {"verify_env": verify_env, "base_branch": base, "platform": platform}
    text = "verify_env=%s\nbase_branch=%s\nplatform=%s" % (verify_env, base, platform)
    out.update({"harness": harness, "harness_source": source})
    text += "\nharness=%s (%s)" % (harness, source)
    emit(args, out, text)




def cmd_platform(args):
    p = resolve_platform()
    harness, source = resolve_harness()
    out = {"platform": p, "harness": harness, "harness_source": source}
    emit(args, out, p + "\nharness: %s (%s)" % (harness, source))


def cmd_add(args, db, sdir):
    if not TICKET_ID.match(args.ticket) or ".." in args.ticket:
        raise Refusal(EXIT_USAGE, "invalid ticket id %r: use letters, digits, '.', '_'"
                      " and '-', starting with a letter or digit, no '..'" % args.ticket)
    if db.execute("SELECT 1 FROM tickets WHERE id=?", (args.ticket,)).fetchone():
        raise Refusal(EXIT_GATE, "ticket already exists: %s" % args.ticket)
    db.execute(
        "INSERT INTO tickets (id, title, url, phase, created_at) VALUES (?,?,?,?,?)",
        (args.ticket, args.title, args.url, "ready", now()),
    )
    log_event(db, args.ticket, "add", None, "ready", args.title)
    emit(args, ticket_dict(get_ticket(db, args.ticket), load_config(sdir)),
         "added %s" % args.ticket)


def cmd_list(args, db, sdir):
    emit_tickets(args, db.execute("SELECT * FROM tickets ORDER BY seq").fetchall(),
                 load_config(sdir))


def cmd_show(args, db, sdir):
    row = get_ticket(db, args.ticket)
    t = ticket_dict(row, load_config(sdir))
    runs = ticket_runs(db, args.ticket)
    t.update({
        "bounces": row["bounces"],
        "model_mismatches": sum(1 for r in runs if r["match"] == 0),
        "unrecorded_dispatches": db.execute(
            "SELECT COUNT(*) FROM events WHERE ticket=? AND kind='dispatch_unrecorded'",
            (args.ticket,)).fetchone()[0],
    })
    text = "\n".join("%s: %s" % (k, v) for k, v in t.items())
    if runs:
        text += "\nruns:\n" + fmt_runs(runs)
    t["runs"] = runs
    emit(args, t, text)


def cmd_next(args, db, sdir):
    cfg = load_config(sdir)
    rows = db.execute("SELECT * FROM tickets ORDER BY seq").fetchall()
    active = sum(1 for r in rows if is_active(r))
    slots = max(0, int(cfg.get("max_workers", 3)) - active)
    ready = [r for r in rows if r["phase"] == "ready" and r["retired_at"] is None]
    owners = {b["owner"] for b in baseline_records(db)
              if not b.get("fix_sha") and b["gate"] == "full-suite"
              and any(t != b["owner"] for t in b["affected"])}
    ready.sort(key=lambda r: r["id"] not in owners)
    emit_tickets(args, ready[:slots], cfg)


def cmd_stale(args, db, sdir):
    cfg = load_config(sdir)
    rows = db.execute("SELECT * FROM tickets ORDER BY seq").fetchall()
    emit_tickets(args, [r for r in rows if is_stale(r, row_alive(r), cfg)], cfg)


def check_prompt_size(platform, tid, text):
    size = len(text.encode("utf-8"))
    if platform in ("orca", "herdr") and size > MAX_PANE_PROMPT:
        raise Refusal(EXIT_GATE, "prompt for %s is %d bytes; %s passes it as one"
                      " command-line argument, limited to %d bytes (128 KB)"
                      % (tid, size, platform, MAX_PANE_PROMPT))


def contains(parent, child):
    return child == parent or child.startswith(parent.rstrip(os.sep) + os.sep)


def check_worktree(db, tid, worktree):
    """A ticket worktree is never the main checkout, never inside it (unless it
    is a linked worktree of its own), and never overlaps the worktree of
    another active ticket."""
    try:
        main = main_checkout()
    except Refusal:
        main = None
    if main and contains(worktree, main):
        raise Refusal(EXIT_GATE, "worktree %s is the main checkout %s or contains it;"
                      " a ticket needs its own worktree" % (worktree, main))
    if main and contains(main, worktree):
        top = git_lines("-C", worktree, "rev-parse", "--show-toplevel")
        if not top or os.path.realpath(top[0].strip()) == main:
            raise Refusal(EXIT_GATE, "worktree %s lies inside the main checkout %s and is"
                          " not a linked worktree; a ticket needs its own worktree"
                          % (worktree, main))
    for other in db.execute(
            "SELECT id, worktree FROM tickets WHERE worktree IS NOT NULL AND id<>?"
            " AND retired_at IS NULL AND phase NOT IN ('ready', 'done')", (tid,)):
        if other["worktree"] == worktree:
            raise Refusal(EXIT_GATE, "worktree %s is already used by ticket %s"
                          % (worktree, other["id"]))
        if contains(worktree, other["worktree"]) or contains(other["worktree"], worktree):
            raise Refusal(EXIT_GATE, "worktree %s overlaps %s, the worktree of ticket %s"
                          % (worktree, other["worktree"], other["id"]))


def new_session_id(harness):
    """The id a new session starts under: chosen by orch for claude and pi;
    Codex picks its own, which reaches orch with the SessionStart hook."""
    return None if harness == "codex" else str(uuid.uuid4())


def check_spawnable(row, tid):
    if row["retired_at"] is not None:
        raise Refusal(EXIT_GATE, "ticket %s is retired" % tid)
    if row["phase"] != "ready":
        raise Refusal(EXIT_GATE, "spawn requires phase ready; %s is %s"
                      % (tid, row["phase"]))


def spawn_ticket(db, sdir, cfg, tid, brief, platform, worktree=None, wref=None,
                 harness="claude"):
    """`spawn` without the printing. With no `worktree`, the platform adapter
    creates one first (and removes it again if the launch fails). Returns
    (output, is_action)."""
    check_harness_platform(harness, platform)
    with transaction(db):
        row = get_ticket(db, tid)
        check_spawnable(row, tid)
        if not brief.strip():
            raise Refusal(EXIT_GATE, "brief for %s is empty" % tid)
        if verification_policy(cfg) == "local-tests":
            if not retained_verification_context(brief):
                brief += "\n\n" + LOCAL_TESTS_CONTEXT
            if LOCAL_TESTS_MARKER not in brief.splitlines():
                brief += "\n\n" + LOCAL_TESTS_MARKER
        check_prompt_size(platform, tid, ticket_prompt(brief, harness))
        if worktree is not None:
            if not os.path.isdir(worktree):
                raise Refusal(EXIT_GATE, "worktree does not exist: %s" % worktree)
            worktree = os.path.realpath(worktree)
            check_worktree(db, tid, worktree)
        else:
            check_name_free(db, tid)
        # Claimed before the worktree is made: no second spawn (of this ticket,
        # or of one with the same worktree name) creates or launches meanwhile.
        marker = claim_launch(db, row, "spawn")
    try:
        return spawn_claimed(db, sdir, cfg, tid, brief, platform, worktree, wref, marker,
                             harness)
    finally:
        release_launch(db, tid, marker)


def check_name_free(db, tid):
    name = worktree_name(tid)
    for other in db.execute("SELECT * FROM tickets WHERE id<>? AND retired_at IS NULL",
                            (tid,)).fetchall():
        if worktree_name(other["id"]) == name and launch_in_progress(other):
            refuse_if_launching(other, "%s (worktree name %s, as for %s)"
                                % (other["id"], name, tid))


def spawn_claimed(db, sdir, cfg, tid, brief, platform, worktree, wref, marker,
                  harness="claude"):
    created = worktree is None
    if created:
        worktree, wref = create_worktree(platform, tid)

    def discard():
        if created:
            try:
                remove_worktree(platform, tid, worktree, wref, force=True)
            except Refusal as e:
                print("orch: warning: %s" % e, file=sys.stderr)

    try:
        with transaction(db):
            row = get_ticket(db, tid)
            check_spawnable(row, tid)
            if row["launching"] != marker:
                raise Refusal(EXIT_GATE, "the launch claim on %s was taken over;"
                              " not launching" % tid)
            check_worktree(db, tid, worktree)
            prompt_file = write_prompt(sdir, tid + ".md", ticket_prompt(brief, harness))
            sid = new_session_id(harness)
            # Step 1: commit the intent before launching, so a crash after
            # launch never leaves a running session behind a `ready` ticket.
            db.execute(
                "UPDATE tickets SET phase='dispatched', platform=?, pid=NULL,"
                " pid_start=NULL, session_id=?, worktree=?, attempt=1, brief=?,"
                " activity=NULL, session_seen=0, launch_ref=NULL, launched_at=?,"
                " worktree_ref=?, worktree_branch=?, harness=? WHERE id=?",
                (platform, sid, worktree, brief, now(),
                 json.dumps(wref) if wref else None, git_branch_of(worktree), harness, tid))
            ev = log_event(db, tid, "spawn", "ready", "dispatched",
                           "session=%s platform=%s%s" % (
                               sid, platform,
                               "" if harness == "claude" else " harness=" + harness))
    except Refusal:
        discard()
        raise
    try:
        return finish_launch(db, sdir, cfg, row, [ev], platform,
                             {"mode": "start", "sid": sid}, prompt_file, "desktop_start",
                             marker)
    except TrustBlocked:
        raise
    except Refusal:
        discard()
        raise


def print_launch(args, out, is_action, done_text):
    if is_action:
        print(json.dumps(out))
    else:
        emit(args, out, "%s %s on %s pid=%s session=%s" % (
            done_text, out["id"], out["platform"], out["pid"], out["session_id"]))


def cmd_spawn(args, db, sdir):
    platform = require_platform(args.platform)
    harness = resolve_harness(args.harness)[0]
    cfg = load_config(sdir)
    get_ticket(db, args.ticket)
    try:
        with open(args.brief_file) as f:
            brief = f.read()
    except OSError as e:
        raise Refusal(EXIT_USAGE, "cannot read brief file: %s" % e)
    out, is_action = spawn_ticket(db, sdir, cfg, args.ticket, brief, platform,
                                  args.worktree, harness=harness)
    print_launch(args, out, is_action, "spawned")


cmd_spawn.own_tx = True


def codex_rollout_exists(sid):
    """Whether Codex saved the thread `sid` (its rollout file), which is what
    `codex resume` needs: a thread killed before its first turn has none."""
    pattern = os.path.join(codex_home(), "sessions", "*", "*", "*",
                           "rollout-*-%s.jsonl" % glob.escape(sid))
    return bool(glob.glob(pattern))


def codex_thread_from_log(sdir, tid):
    """The last thread id a headless codex printed to the ticket's log."""
    found = None
    try:
        with open(log_path(sdir, tid)) as f:
            for line in f:
                if "thread.started" not in line:
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if isinstance(obj, dict) and obj.get("type") == "thread.started" \
                        and isinstance(obj.get("thread_id"), str) and obj["thread_id"]:
                    found = obj["thread_id"]
    except OSError:
        pass
    return found


def session_continuable(sdir, row, harness):
    """Whether the recorded session can be continued rather than started over:
    it reported in, or its headless log shows it was created. A Codex thread
    also needs its rollout on disk."""
    sid = row["session_id"]
    if not sid:
        return False
    if harness == "codex":
        return codex_rollout_exists(sid)
    return bool(row["session_seen"]) or session_created(sdir, row["id"], sid, harness)


def resume_ticket(db, sdir, cfg, tid, note=None, platform=None, harness=None):
    """`resume` without the printing. Returns (output, is_action)."""
    with transaction(db):
        row = get_ticket(db, tid)
        if row["retired_at"] is not None:
            raise Refusal(EXIT_GATE, "ticket %s is retired" % tid)
        if row["phase"] in ("ready", "done"):
            raise Refusal(EXIT_GATE, "cannot resume %s in phase %s" % (tid, row["phase"]))
        refuse_if_launching(row)
        if row_alive(row):
            raise Refusal(EXIT_GATE, "session for %s is still alive (pid %s)"
                          % (tid, row["pid"]))
        old_harness = row_harness(row)
        if not row["worktree"] or (not row["session_id"] and old_harness != "codex"):
            raise Refusal(EXIT_GATE, "ticket %s has no recorded session" % tid)
        if row["phase"] == "blocked" and not row["prior_phase"]:
            raise Refusal(EXIT_GATE, "%s is blocked with no remembered phase" % tid)
        platform = platform or row_platform(row)
        harness = harness or old_harness
        check_harness_platform(harness, platform)
        sid = row["session_id"]
        seen = row["session_seen"]
        if old_harness == "codex" and not sid and row_platform(row) == "headless":
            # Killed before its SessionStart hook attached it: its own output
            # still names the thread.
            sid = codex_thread_from_log(sdir, tid)
            row = dict(row, session_id=sid)
        extra = ("\n\nNote from the orchestrator:\n" + note) if note else ""
        if harness == old_harness and session_continuable(sdir, row, harness):
            context = retained_verification_context(row["brief"])
            prompt = resume_prompt(tid, harness)
            if context:
                prompt += "\n\n" + context
            prompt += extra
            session = {"mode": "resume", "sid": sid}
        else:
            # Nothing to continue (the session never reported in, or the ticket
            # moves to another harness): start it fresh from the brief, under
            # the same id when the harness lets orch choose it.
            if not (row["brief"] or "").strip():
                raise Refusal(EXIT_GATE, "no stored brief for %s; re-spawn" % tid)
            prompt = ticket_prompt(row["brief"] + extra, harness)
            if harness != old_harness or harness == "codex":
                sid, seen = new_session_id(harness), 0
            session = {"mode": "start", "sid": sid}
        check_prompt_size(platform, tid, prompt)
        prompt_file = write_prompt(sdir, tid + ".resume.md", prompt)
        evs = []
        phase = row["phase"]
        if phase == "blocked":
            phase = row["prior_phase"]
            db.execute("UPDATE tickets SET phase=?, prior_phase=NULL WHERE id=?",
                       (phase, tid))
            evs.append(log_event(db, tid, "unblock", "blocked", phase, "resume"))
        attempt = row["attempt"] + 1
        marker = claim_launch(db, row, "resume")
        db.execute("UPDATE tickets SET pid=NULL, pid_start=NULL, activity=NULL,"
                   " platform=?, attempt=?, launched_at=?, harness=?, session_id=?,"
                   " session_seen=? WHERE id=?",
                   (platform, attempt, now(), harness, sid, seen, tid))
        mode = session["mode"]
        if harness == "claude" and mode == "start":
            mode = "session-id"
        evs.append(log_event(db, tid, "resume", phase, phase,
                             "attempt=%d mode=%s platform=%s%s%s" % (
                                 attempt, mode, platform,
                                 "" if harness == old_harness else " harness=" + harness,
                                 (" note=" + note) if note else "")))
    return finish_launch(db, sdir, cfg, row, evs, platform, session, prompt_file,
                         "desktop_resume", marker)


def cmd_resume(args, db, sdir):
    platform = require_platform(args.platform)
    if not args.platform:
        platform = None  # the ticket's own platform
    out, is_action = resume_ticket(db, sdir, load_config(sdir), args.ticket, args.note,
                                   platform, args.harness)
    print_launch(args, out, is_action, "resumed")


cmd_resume.own_tx = True


def cmd_attach(args, db, sdir):
    if not args.ref and not args.session_id:
        raise Refusal(EXIT_USAGE, "attach needs --ref and/or --session-id")
    row = get_ticket(db, args.ticket)
    if row["retired_at"] is not None:
        raise Refusal(EXIT_GATE, "ticket %s is retired" % args.ticket)
    detail = []
    if args.ref:
        db.execute("UPDATE tickets SET launch_ref=? WHERE id=?",
                   (json.dumps({"desktop": args.ref}), args.ticket))
        detail.append("ref=" + args.ref)
    if args.session_id:
        if args.session_id != row["session_id"]:
            # A different session: the old process identity no longer applies.
            db.execute("UPDATE tickets SET session_id=?, pid=NULL, pid_start=NULL,"
                       " activity=NULL WHERE id=?", (args.session_id, args.ticket))
        detail.append("session=" + args.session_id)
    log_event(db, args.ticket, "attach", row["phase"], row["phase"], " ".join(detail))
    emit(args, ticket_dict(get_ticket(db, args.ticket), load_config(sdir)),
         "%s attached %s" % (args.ticket, " ".join(detail)))


def cmd_phase(args, db, sdir):
    row = get_ticket(db, args.ticket)
    cur, new = row["phase"], args.phase
    if row["retired_at"] is not None:
        raise Refusal(EXIT_GATE, "ticket %s is retired" % args.ticket)
    if new == "done":
        raise Refusal(EXIT_GATE, "done is reachable only through `orch merged`")
    if new not in TRANSITIONS.get(cur, ()):
        message = "illegal transition %s -> %s for %s" % (cur, new, args.ticket)
        if cur == "ready":
            message += "; dispatch the ticket with `orch spawn %s` before phase transitions" % args.ticket
        raise Refusal(EXIT_GATE, message)
    bounce = new == "fix" and cur in ("review", "verify")
    ci_repair = new == "fix" and cur == "ci"
    if bounce or ci_repair:
        column, cap = ("bounces", BOUNCE_CAP) if bounce else ("ci_repairs", CI_REPAIR_CAP)
        count = row[column]
        if count is None or count >= cap:
            why = ("unknown %s history requires evidence-backed human reconciliation" % column
                   if count is None else "%s budget exhausted (%d/%d)" % (column, count, cap))
            raise Refusal(EXIT_GATE, why + "; stop before dispatch and block for a human"
                          " (`orch block %s --reason \"%s; findings: <link>\"`)"
                          % (args.ticket, why))
    if bounce:
        last = last_run(db, args.ticket, "implementor")
        if last and rung_of(last) >= TOP_RUNG:
            raise Refusal(EXIT_GATE, frontier_bounce_msg(args.ticket))
    rounds = row["review_rounds"] + (1 if new == "review" else 0)
    db.execute("UPDATE tickets SET phase=?, review_rounds=?, bounces=bounces+?,"
               " ci_repairs=ci_repairs+? WHERE id=?",
               (new, rounds, 1 if bounce else 0, 1 if ci_repair else 0, args.ticket))
    log_event(db, args.ticket, "phase", cur, new, args.note)
    emit(args, ticket_dict(get_ticket(db, args.ticket), load_config(sdir)),
         "%s: %s -> %s" % (args.ticket, cur, new))


def cmd_block(args, db, sdir):
    row = get_ticket(db, args.ticket)
    cur = row["phase"]
    if cur in ("blocked", "done") or row["retired_at"] is not None:
        raise Refusal(EXIT_GATE, "cannot block %s in phase %s%s" % (
            args.ticket, cur, " (retired)" if row["retired_at"] else ""))
    db.execute("UPDATE tickets SET phase='blocked', prior_phase=? WHERE id=?",
               (cur, args.ticket))
    log_event(db, args.ticket, "block", cur, "blocked", args.reason)
    state_md_log(args.ticket, "blocked: " + args.reason)
    emit(args, ticket_dict(get_ticket(db, args.ticket), load_config(sdir)),
         "%s blocked (was %s)" % (args.ticket, cur))


def cmd_unblock(args, db, sdir):
    row = get_ticket(db, args.ticket)
    if row["phase"] != "blocked":
        raise Refusal(EXIT_GATE, "%s is not blocked (phase %s)"
                      % (args.ticket, row["phase"]))
    prior = row["prior_phase"]
    if not prior:
        raise Refusal(EXIT_GATE, "%s has no remembered phase to return to"
                      % args.ticket)
    db.execute("UPDATE tickets SET phase=?, prior_phase=NULL WHERE id=?",
               (prior, args.ticket))
    log_event(db, args.ticket, "unblock", "blocked", prior, None)
    emit(args, ticket_dict(get_ticket(db, args.ticket), load_config(sdir)),
         "%s unblocked -> %s" % (args.ticket, prior))


def cmd_ci(args, db, sdir):
    row = get_ticket(db, args.ticket)
    if row["phase"] != "ci":
        raise Refusal(EXIT_GATE, "ci requires phase ci; %s is %s"
                      % (args.ticket, row["phase"]))
    verdict = "passed" if args.passed else "failed"
    db.execute("INSERT INTO ci_results (ticket, sha, verdict, ts) VALUES (?,?,?,?)",
               (args.ticket, args.sha, verdict, now()))
    log_event(db, args.ticket, "ci", "ci", "ci", "%s %s" % (args.sha, verdict))
    emit(args, {"id": args.ticket, "sha": args.sha, "verdict": verdict},
         "%s: CI %s for %s" % (args.ticket, verdict, args.sha))


def cmd_merged(args, db, sdir):
    row = get_ticket(db, args.ticket)
    refuse_if_refreshing(row)
    for baseline in baseline_records(db):
        if baseline_action(db, baseline, args.ticket, baseline["gate"]) != "clear":
            raise Refusal(EXIT_GATE, "shared baseline gate requires refresh, tests and review")
        refresh = baseline["refreshes"].get(args.ticket)
        if refresh and refresh.get("new_sha"):
            if args.sha != baseline_head(row):
                raise Refusal(EXIT_GATE, "merge SHA must be the refreshed current HEAD")
    if row["phase"] != "ci":
        raise Refusal(EXIT_GATE, "merged requires phase ci; %s is %s"
                      % (args.ticket, row["phase"]))
    latest = db.execute(
        "SELECT verdict FROM ci_results WHERE ticket=? AND sha=?"
        " ORDER BY seq DESC LIMIT 1", (args.ticket, args.sha)).fetchone()
    if latest is None or latest["verdict"] != "passed":
        raise Refusal(EXIT_GATE, "no passing CI recorded for %s at %s"
                      % (args.ticket, args.sha))
    db.execute("UPDATE tickets SET phase='done' WHERE id=?", (args.ticket,))
    log_event(db, args.ticket, "merged", "ci", "done",
              args.sha + (" " + args.mr if args.mr else ""))
    state_md_log(args.ticket, "completed: " + (args.mr or "commit " + args.sha))
    emit(args, ticket_dict(get_ticket(db, args.ticket), load_config(sdir)),
         "%s merged at %s" % (args.ticket, args.sha))


def target_exists(pid, group):
    try:
        (os.killpg if group else os.kill)(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True
    return True


def kill_session(row, bare_ok):
    """Signal the session, but only if `pid` is still provably that session.
    A group leader gets its whole group signalled (so members that outlive it,
    such as MCP servers and shells, die too). A non-leader pid is signalled on
    its own only when `bare_ok`."""
    pid = row["pid"]
    if not row_alive(row):
        return
    try:
        group = os.getpgid(pid) == pid
    except OSError:
        return
    if not group and not bare_ok:
        return
    send = os.killpg if group else os.kill
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            send(pid, sig)
        except OSError:
            return
        deadline = time.time() + 3.0
        while time.time() < deadline and target_exists(pid, group):
            time.sleep(0.05)
        if not target_exists(pid, group):
            return


def retire_ticket(db, sdir, tid, force, keep_worktree=False):
    """`retire` without the printing: close, signal, remove the worktree, mark
    retired. Returns the desktop_archive action, or None."""
    with transaction(db):
        row = get_ticket(db, tid)
        if row["retired_at"] is not None:
            raise Refusal(EXIT_GATE, "%s is already retired" % tid)
        if row["phase"] != "done" and not force:
            raise Refusal(EXIT_GATE, "retire requires phase done (or --force); %s is %s"
                          % (tid, row["phase"]))
        # No resume may launch while the session is being closed and removed.
        marker = claim_launch(db, row, "retire")
    try:
        return retire_claimed(db, tid, row, force, keep_worktree, marker)
    finally:
        release_launch(db, tid, marker)


def retire_claimed(db, tid, row, force, keep_worktree, marker):
    platform = row_platform(row)
    ref = row_launch_ref(row) or {}
    if platform == "headless":
        kill_session(row, bare_ok=False)
    else:
        _, err = platform_close(platform, ref, row["worktree"])
        if err:
            print("orch: warning: could not close the %s session of %s: %s"
                  % (platform, tid, err), file=sys.stderr)
        kill_session(row, bare_ok=True)
    if not keep_worktree:
        # The worktree goes, so does the trust orch gave it.
        unmark_ticket_trust(db, tid, row["worktree"])
        remove_worktree(platform, tid, row["worktree"], row_worktree_ref(row), force)
    with transaction(db):
        cur = get_ticket(db, tid)
        if cur["retired_at"] is not None:
            raise Refusal(EXIT_GATE, "%s is already retired" % tid)
        db.execute("UPDATE tickets SET retired_at=?, launching=NULL WHERE id=?",
                   (now(), tid))
        log_event(db, tid, "retire", cur["phase"], cur["phase"],
                  " ".join(x for x in ("forced" if force else "",
                                       "kept-worktree" if keep_worktree else "") if x)
                  or None)
    if platform == "desktop":
        return {"action": "desktop_archive", "ref": ref.get("desktop")}
    return None


def cmd_retire(args, db, sdir):
    require_platform()
    action = retire_ticket(db, sdir, args.ticket, args.force, args.keep_worktree)
    if action:
        print(json.dumps(action))
        return
    emit(args, ticket_dict(get_ticket(db, args.ticket), load_config(sdir)),
         "%s retired" % args.ticket)


cmd_retire.own_tx = True


def cmd_events(args, db, sdir):
    get_ticket(db, args.ticket)
    evs = [dict(r) for r in db.execute(
        "SELECT ts, ticket, kind, from_phase, to_phase, detail FROM events"
        " WHERE ticket=? ORDER BY seq", (args.ticket,))]
    emit(args, {"events": evs}, "\n".join(
        "%s\t%s\t%s -> %s\t%s" % (e["ts"], e["kind"], e["from_phase"],
                                  e["to_phase"], e["detail"] or "") for e in evs))



# ---- model routing ---------------------------------------------------------

def run_dict(row):
    result = dict(row)
    for key in ("dispatch", "routing_context"):
        result[key] = json.loads(result[key]) if result[key] is not None else None
    if result["retry_of"] is not None:
        result["retry_of"] = int(result["retry_of"])
    return result


def routing_context(db, row, inputs):
    # The transition identity distinguishes separate visits to a phase, including
    # CI repairs which do not increment bounces. Block/unblock is not a repair.
    event = db.execute(
        "SELECT seq, from_phase, to_phase FROM events WHERE ticket=? AND kind='phase'"
        " ORDER BY seq DESC LIMIT 1", (row["id"],)).fetchone()
    return dict(inputs, phase=row["phase"], bounces=row["bounces"],
                ci_repairs=row["ci_repairs"],
                transition=dict(event) if event else None)


def record_run(db, row, role, tier, value, effort, selected, context,
               retry_of=None, retry_reason=None):
    seq = db.execute(
        "INSERT INTO runs (ticket, role, model_requested, tier, bounce_count,"
        " requested_at, effort_requested, dispatch, routing_context, retry_of, retry_reason)"
        " VALUES (?,?,?,?,?,?,?,?,?,?,?)",
        (row["id"], role, value, tier, row["bounces"], now(), effort,
         json.dumps(selected), json.dumps(context), retry_of, retry_reason)).lastrowid
    log_event(db, row["id"], "retry" if retry_of is not None else "run",
              row["phase"], row["phase"],
              "role=%s model=%s tier=%s effort=%s%s" % (
                  role, value, tier, effort,
                  " retry_of=%s reason=%s" % (retry_of, retry_reason) if retry_of is not None else ""))
    return run_dict(db.execute("SELECT * FROM runs WHERE seq=?", (seq,)).fetchone())


def cmd_retry(args, db, sdir):
    explicit = any(v is not None for v in (args.model, args.effort, args.reason))
    if explicit and not (args.model and args.effort and args.reason and args.reason.strip()):
        raise Refusal(EXIT_USAGE, "a deliberate retry needs --model, --effort and a nonempty --reason")
    row = get_ticket(db, args.ticket)
    if row["retired_at"] is not None:
        raise Refusal(EXIT_GATE, "cannot retry a retired ticket")
    if row["phase"] in ("done", "blocked"):
        raise Refusal(EXIT_GATE, "cannot retry a %s ticket" % row["phase"])
    source = db.execute("SELECT * FROM runs WHERE seq=? AND ticket=?",
                        (args.run, args.ticket)).fetchone()
    if source is None:
        raise Refusal(EXIT_GATE, "run %s not found for ticket %s" % (args.run, args.ticket))
    source = run_dict(source)
    context, selected = source["routing_context"], source["dispatch"]
    if (not isinstance(context, dict)
            or not {"files", "lines", "ambiguous", "phase", "bounces", "ci_repairs", "transition"} <= context.keys()
            or not isinstance(selected, dict)
            or not {"role", "harness", "tier", "model", "effort"} <= selected.keys()):
        raise Refusal(EXIT_GATE, "legacy run lacks retry provenance; reconcile before dispatch")
    if row["bounces"] is None or row["ci_repairs"] is None:
        raise Refusal(EXIT_GATE, "unknown bounce or CI repair history; reconcile before retry")
    inputs = {key: context[key] for key in ("files", "lines", "ambiguous")}
    current = routing_context(db, row, inputs)
    if current != context:
        raise Refusal(EXIT_GATE, "retry phase/repair context changed; use a fresh stage decision")
    transition = current["transition"]
    if row["phase"] == "fix" and (not transition or transition["to_phase"] != "fix"
                                      or transition["from_phase"] not in ("review", "verify", "ci")):
        raise Refusal(EXIT_GATE, "invalid repair provenance; reconcile before retry")
    # The command's write transaction serializes this check with insertion, so
    # two callers cannot create sibling attempts from the same source.
    latest = db.execute(
        "WITH RECURSIVE attempts(seq) AS ("
        " SELECT seq FROM runs WHERE retry_of=? AND ticket=?"
        " UNION SELECT r.seq FROM runs r JOIN attempts a ON r.retry_of=a.seq"
        " WHERE r.ticket=?) SELECT MAX(seq) FROM attempts",
        (source["seq"], args.ticket, args.ticket)).fetchone()[0]
    if latest is not None:
        raise Refusal(EXIT_GATE, "run %s is superseded; latest attempt is %s;"
                      " if another retry is needed, use orch retry %s --run %s"
                      % (source["seq"], latest, args.ticket, latest))
    role, harness = source["role"], row_harness(row)
    if explicit:
        tier, value, implied = tier_of(harness, role, args.model)
        effort = args.effort
        if tier is None or (implied and implied != effort):
            raise Refusal(EXIT_USAGE, "unknown model or conflicting model/effort for retry")
        selected = dict(dispatch(harness, role, tier, effort), role=role, harness=harness)
    else:
        tier, value, effort = source["tier"], source["model_requested"], source["effort_requested"]
        if selected != dict(dispatch(harness, role, tier, effort), role=role, harness=harness):
            raise Refusal(EXIT_GATE, "retry model mapping or harness changed; select --model and --effort with --reason")
    need, need_effort, reasons = route_tier(db, row, role, **inputs)
    if rung(tier, effort) < rung(need, need_effort):
        raise Refusal(EXIT_GATE, "retry is below the current %s/%s floor: %s"
                      % (need, need_effort, "; ".join(reasons)))
    result = record_run(db, row, role, tier, value, effort, selected, current,
                        source["seq"], args.reason if explicit else None)
    emit(args, result, str(result["seq"]))


def ticket_runs(db, tid):
    return [run_dict(r) for r in db.execute("SELECT * FROM runs WHERE ticket=? ORDER BY seq",
                                        (tid,))]


def last_run(db, tid, role):
    return db.execute("SELECT * FROM runs WHERE ticket=? AND role=? ORDER BY seq DESC"
                      " LIMIT 1", (tid, role)).fetchone()


def rung(tier, effort):
    return TIERS.index(tier) * len(EFFORTS) + EFFORTS.index(effort)


def rung_of(run):
    """The rung a recorded run ran at (a run from before efforts: low)."""
    return rung(run["tier"], run["effort_requested"] or EFFORTS[0])


def fmt_runs(runs):
    lines = ["SEQ\tROLE\tTIER\tREQUESTED\tEFFORT\tRESOLVED\tEFFORT_RESOLVED\tMATCH\tBOUNCES"
             "\tAGENT\tREQUESTED_AT"]
    for r in runs:
        lines.append("\t".join(str("-" if v is None else v) for v in (
            r["seq"], r["role"], r["tier"], r["model_requested"], r["effort_requested"],
            r["model_resolved"], r["effort_resolved"], r["match"], r["bounce_count"], r["agent_id"], r["requested_at"])))
    return "\n".join(lines)


def frontier_bounce_msg(tid):
    return ("the implementor of %s already ran at frontier/high; there is no higher rung to"
            " escalate to: block the ticket for a human (`orch block %s --reason"
            " \"bounced after a frontier implementor\"`)" % (tid, tid))


def machine_config():
    """The machine config (platforms.md "Machine config"), or {}."""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    try:
        with open(os.path.join(base, "orchestration", "config.json")) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def pi_models():
    """tier -> model: PI_MODELS with the machine config's
    `pi_models` override, keyed by tier or by an old alias (a tier key wins;
    `opus` sets heavy and frontier, which share a model).
    The same map as pi/extension.ts piModels()."""
    out = dict(PI_MODELS)
    own = machine_config().get("pi_models")
    if isinstance(own, dict):
        keyed = [(t, v) for k, v in own.items() if k in PI_MODEL_ALIASES
                 for t in PI_MODEL_ALIASES[k]]
        keyed += [(k, v) for k, v in own.items() if k in TIERS]
        for tier, model in keyed:
            if isinstance(model, str) and model:
                out[tier] = model
    return out


def dispatch(harness, role, tier, effort):
    """The dispatch value of `tier` at `effort` on `harness` as a dict (route's
    JSON minus floors)."""
    d = {"tier": tier, "effort": effort}
    if harness == "codex":
        d["model"] = CODEX_MODELS[tier]
        if role in AGENT_ROLES:
            d["agent"] = "%s-%s-%s" % (role, tier, effort)
    elif harness == "pi":
        d["model"] = pi_models()[tier]
        d["thinking"] = PI_THINKING[effort]
    else:
        d["model"] = CLAUDE_MODELS[tier]
    return d


def tier_of(harness, role, value):
    """(tier, the value to record, the effort a Codex agent name implies or
    None) for a --model value: a tier name, the harness's dispatch value, or on
    Codex a per-rung agent name. A model two tiers share (Codex/Pi heavy and
    frontier) is the lower tier. None when unknown."""
    if value in TIERS:
        return value, dispatch(harness, role, value, EFFORTS[0])["model"], None
    if harness == "codex":
        for tier in TIERS:
            for effort in EFFORTS:
                if value == "%s-%s-%s" % (role, tier, effort):
                    return tier, value, effort
            if value == CODEX_MODELS[tier]:
                return tier, value, None
    elif harness == "pi":
        models = pi_models()
        for tier in TIERS:
            if value == models[tier]:
                return tier, value, None
    else:
        for tier in TIERS:
            if value == CLAUDE_MODELS[tier]:
                return tier, value, None
    return None, value, None


def route_tier(db, row, role, files=None, lines=None, ambiguous=False):
    """(tier, effort, reasons): the role's default tier at effort low, tier
    bumped by --ambiguous and a large change, then raised to the rung floors
    the ticket's runs set. Refuses an implementor that would need a rung above
    frontier/high."""
    if role not in ROLE_TIERS:
        raise Refusal(EXIT_USAGE, "unknown role %r: one of %s"
                      % (role, ", ".join(sorted(ROLE_TIERS))))
    tid, top = row["id"], len(TIERS) - 1
    level, reasons = TIERS.index(ROLE_TIERS[role]), []
    if ambiguous:
        level += 1
        reasons.append("ambiguous: one tier up")
    if role in SIZE_ROLES and ((files or 0) > BIG_FILES or (lines or 0) > BIG_LINES):
        level += 1
        reasons.append("large change (> %d files or > %d lines): one tier up"
                       % (BIG_FILES, BIG_LINES))
    level = min(level, top) * len(EFFORTS)
    floors = []
    impl = last_run(db, tid, "implementor")
    if role == "implementor" and impl is not None and row["bounces"] is not None and row["bounces"] > impl["bounce_count"]:
        if rung_of(impl) >= TOP_RUNG:
            raise Refusal(EXIT_GATE, frontier_bounce_msg(tid))
        floors.append((rung_of(impl) + 1, "after a bounce: one rung above the last"
                       " implementor (%s/%s)" % (impl["tier"],
                                                 impl["effort_requested"] or EFFORTS[0])))
    if role == "reviewer" and impl is not None:
        floors.append(((TIERS.index(impl["tier"]) - 1) * len(EFFORTS),
                       "reviewer: at most one tier below the last implementor (%s)"
                       % impl["tier"]))
    tiers = [TIERS.index(r["tier"]) for r in db.execute(
        "SELECT tier FROM runs WHERE ticket=?", (tid,)) if r["tier"] in TIERS]
    if tiers:
        floors.append(((max(tiers) - 1) * len(EFFORTS),
                       "no de-escalation: at most one tier below the highest on the"
                       " ticket (%s)" % TIERS[max(tiers)]))
    for floor, why in floors:
        if min(floor, TOP_RUNG) > level:
            reasons.append(why)
    level = min(max([level] + [f for f, _ in floors]), TOP_RUNG)
    return TIERS[level // len(EFFORTS)], EFFORTS[level % len(EFFORTS)], reasons


def size_args(args):
    return {"files": args.files, "lines": args.lines, "ambiguous": args.ambiguous}


def cmd_route(args, db, sdir):
    row = get_ticket(db, args.ticket)
    tier, effort, reasons = route_tier(db, row, args.role, **size_args(args))
    d = dispatch(row_harness(row), args.role, tier, effort)
    d["floors"] = reasons
    text = [d["model"], "tier: %s" % tier]
    text += ["%s: %s" % (k, d[k]) for k in ("effort", "thinking", "agent") if k in d]
    text += ["why: %s" % r for r in reasons]
    emit(args, d, "\n".join(text))


def cmd_run(args, db, sdir):
    row = get_ticket(db, args.ticket)
    refuse_if_refreshing(row)
    harness = row_harness(row)
    if args.role not in ROLE_TIERS:
        route_tier(db, row, args.role)  # raises the usage error
    tier, value, implied = tier_of(harness, args.role, args.model)
    if implied and implied != args.effort:
        raise Refusal(EXIT_USAGE, "%s names effort %s but --effort is %s"
                      % (args.model, implied, args.effort))
    if tier is None:
        raise Refusal(EXIT_USAGE, "unknown model %r for harness %s: use a tier (%s) or"
                      " the value `orch route` prints" % (args.model, harness,
                                                          ", ".join(TIERS)))
    if args.effort is None:
        raise Refusal(EXIT_USAGE, "run needs --effort (%s)" % "|".join(EFFORTS))
    if row["bounces"] is None:
        raise Refusal(EXIT_GATE, "unknown bounce history for %s; cannot record a run"
                      " snapshot until evidence-backed human reconciliation. Stop dispatch"
                      " and orch block %s --reason '<unknown bounce history; findings link>'"
                      % (args.ticket, args.ticket))
    need, need_effort, reasons = route_tier(db, row, args.role, **size_args(args))
    if rung(tier, args.effort) < rung(need, need_effort):
        raise Refusal(EXIT_GATE, "%s/%s is %s/%s, below the %s/%s floor for %s on %s%s" % (
            args.model, args.effort, tier, args.effort, need, need_effort,
            args.role, args.ticket,
            (": " + "; ".join(reasons)) if reasons else " (the role's default)"))
    selected = dict(dispatch(harness, args.role, tier, args.effort),
                    role=args.role, harness=harness)
    r = record_run(db, row, args.role, tier, value, args.effort, selected,
                   routing_context(db, row, size_args(args)))
    emit(args, r, str(r["seq"]))


def cmd_runs(args, db, sdir):
    get_ticket(db, args.ticket)
    runs = ticket_runs(db, args.ticket)
    emit(args, {"runs": runs}, fmt_runs(runs))


# ---- watch -------------------------------------------------------------------

def watch_frame(sdir):
    db = connect(sdir)
    try:
        cfg = load_config(sdir)
        rows = db.execute("SELECT * FROM tickets WHERE retired_at IS NULL"
                          " ORDER BY seq").fetchall()
        state_md_sync(db)
        return [{"id": r["id"], "platform": row_platform(r), "phase": r["phase"],
                 "health": t["health"], "last_seen_at": r["last_seen_at"],
                 "review_rounds": r["review_rounds"]}
                for r, t in ((r, ticket_dict(r, cfg, full=False)) for r in rows)]
    finally:
        db.close()


def cmd_watch(args):
    sdir = state_dir()
    while True:
        ts = watch_frame(sdir)
        if args.json:
            print(json.dumps({"tickets": ts}))
        else:
            if not args.once and sys.stdout.isatty():
                sys.stdout.write("\033[H\033[2J")
            print("%-24s %-9s %-10s %-8s %-25s %s" % (
                "TICKET", "PLATFORM", "PHASE", "HEALTH", "LAST ACTIVITY", "ROUNDS"))
            for t in ts:
                print("%-24s %-9s %-10s %-8s %-25s %s" % (
                    t["id"], t["platform"], t["phase"], t["health"],
                    t["last_seen_at"] or "-", t["review_rounds"]))
        sys.stdout.flush()
        if args.once:
            return
        try:
            time.sleep(max(0.2, args.interval))
        except KeyboardInterrupt:
            return


# ---- routing smoke test ----------------------------------------------------------

SMOKE_MODELS = ("haiku", "fable")
SMOKE_TIMEOUT_S = 180
SMOKE_PROMPT = ('Use the Agent tool once, with subagent_type "general-purpose" and'
                ' model "%s" and effort "%s", on this task: "Reply with one line naming your'
                ' model; use no tools." Then stop. Do nothing else.')


def claude_projects_dir():
    return os.path.join(os.environ.get("CLAUDE_CONFIG_DIR")
                        or os.path.expanduser("~/.claude"), "projects")


def smoke_routing(models, cfg, effort="high"):
    """For each Claude model alias, a headless session dispatches a subagent
    with it and `effort`; the subagent's transcript (not its self-report) gives
    the model and effort it ran at. Returns [{"requested", "effort_requested",
    "resolved", "effort_resolved", "ok", "note"}]."""
    root = project_root()
    key = re.sub(r"[^A-Za-z0-9]", "-", root)
    env = {k: v for k, v in os.environ.items() if k not in LAUNCH_ENV_DROP}
    results = []
    for value in models:
        sid = str(uuid.uuid4())
        argv = [harness_bin("claude")] + headless_argv(
            "claude", {"mode": "start", "sid": sid}, harness_args("claude", cfg))
        note = ""
        try:
            proc = subprocess.Popen(argv, cwd=root, env=env, stdin=subprocess.PIPE,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                    text=True, start_new_session=True)
            try:
                proc.communicate(SMOKE_PROMPT % (value, effort), timeout=SMOKE_TIMEOUT_S)
                if proc.returncode:
                    note = "claude exited %d" % proc.returncode
            except subprocess.TimeoutExpired:
                note = "timed out after %ds" % SMOKE_TIMEOUT_S
                with contextlib.suppress(OSError):
                    os.killpg(proc.pid, signal.SIGKILL)
                proc.wait()
        except OSError as e:
            note = "cannot start %s: %s" % (argv[0], e)
        resolved = resolved_effort = None
        paths = glob.glob(os.path.join(claude_projects_dir(), key, sid, "subagents",
                                       "agent-*.jsonl"))
        for path in sorted(paths, key=os.path.getmtime):
            m, e = transcript_model(path)
            if m:
                resolved, resolved_effort = m, e
        if not resolved and not note:
            note = "no subagent transcript with a model"
        results.append({"requested": value, "effort_requested": effort,
                        "resolved": resolved, "effort_resolved": resolved_effort,
                        "ok": bool(resolved) and resolved.startswith("claude-%s-" % value)
                        and resolved_effort == effort,
                        "note": note})
    return results


def fmt_smoke(results):
    lines = ["%-14s %-28s %s" % ("REQUESTED", "RESOLVED", "RESULT")]
    for r in results:
        lines.append("%-14s %-28s %s" % ("%s/%s" % (r["requested"], r["effort_requested"]),
                                         ("%s/%s" % (r["resolved"], r["effort_resolved"] or "-"))
                                         if r["resolved"] else "-",
                                         ("pass" if r["ok"] else "FAIL")
                                         + ((" (%s)" % r["note"]) if r["note"] else "")))
    return lines


def cmd_smoke_routing(args):
    harness = resolve_harness()[0]
    if harness != "claude":
        raise Refusal(EXIT_GATE, "smoke-routing is not supported on %s: it checks"
                      " Claude Code's Agent tool model routing" % harness)
    models = []
    for value in args.models or SMOKE_MODELS:
        alias = CLAUDE_MODELS.get(value, value)
        if alias not in CLAUDE_MODELS.values():
            raise Refusal(EXIT_USAGE, "unknown model %r: one of %s or a tier" % (
                value, ", ".join(CLAUDE_MODELS.values())))
        models.append(alias)
    results = smoke_routing(models, load_config(state_dir()), args.effort)
    emit(args, {"results": results, "ok": all(r["ok"] for r in results)},
         "\n".join(fmt_smoke(results)))
    failed = [r["requested"] for r in results if not r["ok"]]
    if failed:
        raise Refusal(EXIT_GATE, "model routing smoke test failed for %s"
                      % ", ".join(failed))


# ---- selftest ------------------------------------------------------------------

SELFTEST_STEPS = ("preflight", "create", "launch", "report-in", "state", "visible",
                  "kill", "resume", "teardown", "clean")
class Terminated(BaseException):
    """SIGTERM, raised like KeyboardInterrupt so selftest can still clean up."""


def raise_terminated(signum, frame):
    raise Terminated()


SELFTEST_BRIEF = ("You are a selftest session. Run `%s phase %s spec`, then stop."
                  " Do nothing else.")


class Selftest:
    """The selftest as a resumable state machine. Each stage either finishes
    (records its step and moves on) or, on Desktop, returns an action for the
    main orchestrator and waits for `--continue`."""

    def __init__(self, db, sdir, state):
        self.db, self.sdir, self.st = db, sdir, state
        self.cfg = load_config(sdir)

    # -- bookkeeping --
    def record(self, name, status, detail=""):
        self.st["steps"].append({"name": name, "status": status, "detail": str(detail)})
        if status == "fail" and name not in ("teardown", "clean"):
            self.st["failed"] = True

    def recorded(self):
        return {s["name"] for s in self.st["steps"]}

    def row(self):
        return self.db.execute("SELECT * FROM tickets WHERE id=?",
                               (self.st["ticket"],)).fetchone()

    def deadline(self):
        return time.time() + float(self.st["timeout"])

    def poll(self, fn, until):
        while True:
            got = fn()
            if got or time.time() >= until:
                return got
            time.sleep(0.2)

    def action(self, name, **extra):
        self.st["awaiting"] = name
        out = {"run": self.st["run"], "action": name, "ticket": self.st["ticket"]}
        out.update(extra)
        return out

    def take_answer(self, name):
        """The answer to the pending `name` action, or None."""
        if self.st.get("awaiting") != name:
            return None
        self.st["awaiting"] = None
        ans = self.st.pop("answer", None)
        return ans if isinstance(ans, dict) else {}

    def desktop(self):
        return self.st["platform"] == "desktop"

    def steps(self):
        """SELFTEST_STEPS, then the routing smoke test on Claude unless skipped."""
        extra = ("routing",) if self.st.get("routing") \
            and self.st.get("harness") == "claude" else ()
        return SELFTEST_STEPS + extra

    def current(self):
        return next((n for n in self.steps() if n not in self.recorded()), None)

    def step(self, name):
        return getattr(self, "step_" + name.replace("-", "_"))()

    # -- driver --
    def run(self):
        """Advance as far as possible. Returns an action dict, or None when done."""
        for name in SELFTEST_STEPS + ("routing",):
            # steps() knows the harness only once preflight has run.
            if name in self.recorded() or name not in self.steps():
                continue
            if self.st.get("failed") and name not in ("teardown", "clean"):
                self.record(name, "skip", "an earlier step failed")
                continue
            out = self.step(name)
            if out is not None:
                return out
        return None

    def drive(self):
        """`run`, failing the step in progress on an error and carrying on, so
        teardown and clean always get their turn."""
        while True:
            try:
                return self.run()
            except Exception as e:
                name = self.current()
                if name is None:
                    return None
                self.record(name, "fail", "%s: %s" % (type(e).__name__, e))
                if name == "clean":
                    self.safe_purge()

    def interrupted(self, exc):
        """After Ctrl-C or SIGTERM: fail the step in progress, skip the rest,
        then teardown and clean, each guarded and never waiting on the main
        orchestrator."""
        why = "interrupted (%s)" % ("SIGTERM" if isinstance(exc, Terminated)
                                    else "SIGINT")
        self.st["interrupted"] = why
        self.st["awaiting"] = None
        name = self.current()
        if name:
            self.record(name, "fail", why)
        for name in self.steps():
            if name in self.recorded():
                continue
            if name not in ("teardown", "clean"):
                self.record(name, "skip", why)
                continue
            try:
                out = self.step(name)
                if out is not None:
                    self.st["awaiting"] = None
                    self.record(name, "fail", "%s before the main orchestrator could %s"
                                % (why, out["action"]))
            except BaseException as e:  # a second Ctrl-C included
                if name not in self.recorded():
                    self.record(name, "fail", "%s: %s" % (type(e).__name__, e))
        self.safe_purge()

    # -- steps --
    def step_preflight(self):
        fails = []
        try:
            platform = resolve_platform()
        except Refusal as e:
            platform = None
            fails.append(str(e))
        self.st["platform"] = platform
        try:
            harness = resolve_harness(self.st.get("harness_flag"))[0]
            if platform:
                check_harness_platform(harness, platform)
        except Refusal as e:
            harness = None
            fails.append(str(e))
        self.st["harness"] = harness
        binary = platform_bin(platform) if platform else None
        if binary and not shutil.which(binary):
            fails.append("`%s` is not on PATH" % binary)
        if harness and (platform == "headless" or harness != "claude") \
                and not shutil.which(harness_bin(harness)):
            fails.append("`%s` is not on PATH" % harness_bin(harness))
        try:
            main_checkout()
            base, orch_file = base_branch()
            if not base:
                fails.append("BASE_BRANCH is not set in %s" % orch_file)
        except Refusal as e:
            fails.append(str(e))
        if fails:
            self.record("preflight", "fail", "; ".join(fails))
        else:
            self.record("preflight", "pass", "platform %s, harness %s" % (platform, harness))

    def step_create(self):
        tid = self.st["ticket"]
        if self.st["platform"] == "herdr" and "main_ws_open" not in self.st:
            # `herdr worktree open` (launch) opens a workspace for the main
            # checkout when none is open; teardown closes only one it opened.
            # Unknown counts as open: never close what we cannot prove we opened.
            try:
                self.st["main_ws_open"] = herdr_main_workspace(main_checkout()) is not None
            except ToolError as e:
                self.st["main_ws_open"] = True
                self.st["main_ws_note"] = ("main checkout workspace state unknown before"
                                           " launch, left open: %s" % e)
        with transaction(self.db):
            self.db.execute("INSERT INTO tickets (id, title, phase, created_at)"
                            " VALUES (?,?,?,?)", (tid, "orch selftest", "ready", now()))
            log_event(self.db, tid, "add", None, "ready", "selftest run %s"
                      % self.st["run"])
        self.st["created"] = True
        main = main_checkout()
        before = git_branches(main)
        # Known before create runs, so teardown finds what an interrupted or
        # half-failed create left behind.
        self.st["wt_name"] = name = worktree_name(tid)
        self.st["branch_existed"] = name in before
        try:
            wt, wref = create_worktree(self.st["platform"], tid)
        except Refusal as e:
            return self.record("create", "fail", e)
        self.st["wt"], self.st["wref"] = wt, wref
        branch = git_branch_of(wt)
        self.st["branch"] = branch
        if not os.path.isdir(wt) or wt not in git_worktrees(main):
            return self.record("create", "fail", "%s is not a git worktree" % wt)
        if not branch or branch in before:
            return self.record("create", "fail", "%s is not on a new branch (%s)"
                               % (wt, branch))
        self.record("create", "pass", "%s on branch %s" % (wt, branch))

    def step_launch(self):
        ans = self.take_answer("desktop_start")
        if ans is not None:
            if ans.get("ok") is False:
                return self.record("launch", "fail", ans.get("detail")
                                   or "the main orchestrator could not start it")
            if ans.get("ref"):
                with transaction(self.db):
                    self.db.execute("UPDATE tickets SET launch_ref=? WHERE id=?",
                                    (json.dumps({"desktop": ans["ref"]}),
                                     self.st["ticket"]))
            return self.record("launch", "pass", "desktop session started")
        tid = self.st["ticket"]
        try:
            try:
                out, is_action = spawn_ticket(
                    self.db, self.sdir, self.cfg, tid,
                    SELFTEST_BRIEF % (shlex.quote(os.path.realpath(__file__)), tid),
                    self.st["platform"], self.st["wt"], self.st.get("wref"),
                    harness=self.st.get("harness") or "claude")
            finally:
                self.note_main_ws_opened()
        except TrustBlocked as e:
            self.st["trust"] = str(e)
            self.st["sid"] = self.row()["session_id"]
            return self.record("launch", "pass", "launched; blocked at folder trust")
        except Refusal as e:
            return self.record("launch", "fail", e)
        self.st["sid"] = self.row()["session_id"]
        if is_action:
            return self.action(out.pop("action"), **out)
        self.record("launch", "pass", "session %s" % (
            self.st["sid"] or "id pending (Codex names it at SessionStart)"))

    def step_report_in(self):
        if self.st.get("trust"):
            return self.record("report-in", "fail", self.st["trust"])

        def seen():
            r = self.row()
            return r["session_seen"] and r["pid"] and \
                health(r, row_alive(r), self.cfg) != "none"
        if self.poll(seen, self.deadline()):
            r = self.row()
            self.st["sid"] = r["session_id"]
            return self.record("report-in", "pass", "pid %s" % r["pid"])
        self.record("report-in", "fail",
                    "no SessionStart hook from the session within %ss; is the"
                    " orchestration plugin enabled for it?" % self.st["timeout"])

    def step_state(self):
        if self.poll(lambda: self.row()["phase"] == "spec", self.deadline()):
            return self.record("state", "pass", "phase spec")
        self.record("state", "fail", "the session did not run `orch phase %s spec`"
                    " (phase %s); check its permissions" % (self.st["ticket"],
                                                            self.row()["phase"]))

    def check_visible(self, name, want):
        ans = self.take_answer("desktop_check")
        if self.desktop():
            if ans is None:
                r = self.row()
                return self.action("desktop_check", cwd=self.st.get("wt"),
                                   title="t" + self.st["ticket"],
                                   ref=(row_launch_ref(r) or {}).get("desktop")
                                   if r else None), None
            v = {"worktree": bool(ans.get("worktree")),
                 "session": bool(ans.get("session")), "detail": ans.get("detail", "")}
        else:
            r = self.row()
            if r is None:
                return None, (False, "ticket row missing")
            v = visible(self.st["platform"], r)
        ok = all(v[k] is not None and bool(v[k]) == want for k in ("worktree", "session"))

        def word(x):
            return "unknown" if x is None else x
        return None, (ok, "worktree=%s session=%s %s" % (
            word(v["worktree"]), word(v["session"]), v.get("detail") or ""))

    def step_visible(self):
        act, res = self.check_visible("visible", True)
        if act:
            return act
        self.record("visible", "pass" if res[0] else "fail", res[1])

    def step_kill(self):
        if self.desktop():
            ans = self.take_answer("desktop_stop")
            if ans is None:
                return self.action("desktop_stop",
                                   ref=(row_launch_ref(self.row()) or {}).get("desktop"))
        else:
            kill_session(self.row(), bare_ok=True)
        self.st["killed_pid"] = self.row()["pid"]
        dead = self.poll(lambda: health(self.row(), row_alive(self.row()), self.cfg)
                         == "dead", self.deadline())
        stale = is_stale(self.row(), row_alive(self.row()), self.cfg)
        if dead and stale:
            return self.record("kill", "pass", "health dead, listed by stale")
        self.record("kill", "fail", "health %s, stale %s" % (
            health(self.row(), row_alive(self.row()), self.cfg), stale))

    def step_resume(self):
        if self.st.get("awaiting") != "desktop_resume":
            try:
                out, is_action = resume_ticket(self.db, self.sdir, self.cfg,
                                               self.st["ticket"])
            except TrustBlocked as e:
                return self.record("resume", "fail", e)
            except Refusal as e:
                return self.record("resume", "fail", e)
            if is_action:
                return self.action(out.pop("action"), **out)
        else:
            self.take_answer("desktop_resume")

        def back():
            r = self.row()
            return (r["session_id"] == self.st["sid"] and r["activity"] is not None
                    and row_alive(r))
        if self.poll(back, self.deadline()):
            return self.record("resume", "pass", "session %s alive again, pid %s"
                               % (self.st["sid"], self.row()["pid"]))
        self.record("resume", "fail", "no SessionStart for session %s after resume"
                    % self.st.get("sid"))

    def step_teardown(self):
        if self.st["keep"]:
            return self.record("teardown", "skip", "--keep")
        if not self.st.get("created"):
            return self.record("teardown", "skip", "nothing was created")
        ans = self.take_answer("desktop_archive")
        if ans is not None:
            if ans.get("ok") is False:
                return self.record("teardown", "fail", ans.get("detail")
                                   or "the main orchestrator could not archive it")
            return self.record("teardown", "pass", "retired; desktop session archived")
        r = self.row()
        try:
            if r is not None and r["session_id"] and not self.st.get("sid"):
                self.st["sid"] = r["session_id"]
            if r is None or not r["worktree"]:
                # A failed launch restores worktree to NULL: retire alone
                # would leave the worktree, branch and DDEV project behind.
                self.remove_orphan(r)
            if r is not None and r["retired_at"] is None:
                act = retire_ticket(self.db, self.sdir, self.st["ticket"], force=True)
                if act and self.desktop() and act.get("ref") \
                        and not self.st.get("interrupted"):
                    return self.action("desktop_archive", ref=act["ref"])
        except Refusal as e:
            notes = [str(e)] + self.close_main_workspace()
            return self.record("teardown", "fail", "; ".join(notes))
        notes = self.close_main_workspace()
        self.record("teardown", "fail" if self.st.get("main_ws_close_failed") else "pass",
                    "; ".join(["retired --force"] + notes))

    def note_main_ws_opened(self):
        """After the launch: record the id of the main checkout's Herdr
        workspace when none was open before, so teardown closes only that
        one. Without an id nothing is closed."""
        if self.st["platform"] != "herdr" or self.st.get("main_ws_open") is not False \
                or "main_ws_opened_id" in self.st:
            return
        try:
            self.st["main_ws_opened_id"] = herdr_main_workspace(main_checkout())
        except ToolError as e:
            self.st["main_ws_opened_id"] = None
            self.st["main_ws_note"] = ("main checkout workspace state unknown after"
                                       " launch, left open: %s" % e)

    def close_main_workspace(self):
        """Close the main checkout's Herdr workspace if this run opened it:
        only the id recorded after the launch, and only while it is still the
        main checkout's. Returns notes for the teardown detail."""
        if self.st.get("main_ws_note"):
            return [self.st["main_ws_note"]]
        opened = self.st.get("main_ws_opened_id")
        if self.st["platform"] != "herdr" or self.st.get("main_ws_open") is not False \
                or not opened:
            return []
        try:
            ws = herdr_main_workspace(main_checkout())
            if ws != opened:
                return []
            call_tool("herdr", ["workspace", "close", ws])
        except ToolError as e:
            self.st["main_ws_close_failed"] = True
            return ["could not close the main checkout workspace selftest opened: %s" % e]
        return ["closed main checkout workspace %s (opened by selftest)" % ws]

    def remove_orphan(self, r):
        """Remove the selftest worktree the ticket row does not name."""
        platform = self.st["platform"]
        main = main_checkout()
        name = self.st.get("wt_name")
        wt = self.st.get("wt")
        if not wt and name:
            found = [w for w in git_worktrees(main)[1:] if os.path.basename(w) == name]
            wt = found[0] if found else None
        if wt:
            self.st.setdefault("wt", wt)
            if r is not None:
                platform_close(row_platform(r), row_launch_ref(r), wt)
                unmark_ticket_trust(self.db, self.st["ticket"], wt)
            remove_worktree(platform, self.st["ticket"], wt, self.st.get("wref"),
                            force=True)
        if name and not self.st.get("branch_existed") and name in git_branches(main) \
                and name not in (git_branch_of(w) for w in git_worktrees(main)):
            subprocess.run(["git", "-C", main, "branch", "-D", name],
                           capture_output=True)
            self.st.setdefault("branch", name)

    def step_clean(self):
        if self.st["keep"]:
            return self.record("clean", "skip", "--keep")
        if not self.st.get("created"):
            return self.record("clean", "skip", "nothing was created")
        problems, notes = [], []
        r = self.row()
        if r is not None and self.st.get("wt"):
            if self.desktop() and self.st.get("interrupted"):
                problems.append("visibility not checked: %s" % self.st["interrupted"])
            else:
                act, res = self.check_visible("clean", False)
                if act:
                    return act
                if not res[0]:
                    problems.append("still visible: " + res[1])
        # The row, read before it is purged, has the session id even when
        # launch never recorded one in the run state (folder trust).
        sid = self.st.get("sid") or (r["session_id"] if r is not None else None)
        trusted = {e["detail"] for e in self.db.execute(
            "SELECT detail FROM events WHERE ticket=? AND kind='trust_mark'",
            (self.st["ticket"],))}
        try:
            for path in sorted(p for p in trusted if p):
                if path.startswith("codex "):
                    path = path[len("codex "):]
                    cfg = os.path.join(codex_home(), "config.toml")
                    try:
                        with open(cfg, encoding="utf-8") as f:
                            text = f.read()
                    except FileNotFoundError:
                        text = ""
                    except (OSError, ValueError) as e:
                        problems.append("codex folder-trust state unknown: %s" % e)
                        continue
                    if codex_trust_block(path) in text:
                        problems.append("folder-trust entry for %s still in %s"
                                        % (path, cfg))
                    continue
                try:
                    if is_trusted(path):
                        problems.append("folder-trust entry for %s still in %s"
                                        % (path, claude_json_path()))
                except TrustError as e:
                    problems.append("folder-trust entry state unknown: %s" % e)
            if sid:
                left = self.poll(lambda: not session_processes(sid), time.time() + 5)
                if not left:
                    problems.append("processes still running for session %s: %s"
                                    % (sid, session_processes(sid)))
            main = main_checkout()
            wt, branch = self.st.get("wt"), self.st.get("branch")
            if not branch and not self.st.get("branch_existed"):
                branch = self.st.get("wt_name")
            if wt and (os.path.exists(wt) or wt in git_worktrees(main)):
                problems.append("worktree %s still exists" % wt)
            if branch and branch in git_branches(main):
                problems.append("branch %s still exists" % branch)
            if self.st["platform"] == "herdr" and self.st.get("main_ws_open") is False:
                opened = self.st.get("main_ws_opened_id")
                try:
                    ws = herdr_main_workspace(main) if opened else None
                except ToolError as e:
                    problems.append("main checkout workspace state unknown: %s" % e)
                else:
                    if ws and ws == opened:
                        problems.append("Herdr workspace %s for the main checkout,"
                                        " opened by selftest, still open" % ws)
            elif self.st["platform"] == "herdr" and self.st.get("main_ws_open"):
                # Open before selftest: not ours, never touched; only noted.
                try:
                    if herdr_main_workspace(main) is None:
                        notes.append("main checkout workspace, open before selftest,"
                                     " is no longer open")
                except ToolError:
                    pass
            if wt:
                try:
                    ddev = ddev_project_at(wt)
                except ToolError as e:
                    problems.append("DDEV state unknown: %s" % e)
                else:
                    if ddev:
                        problems.append("DDEV project %s still exists" % ddev)
        finally:
            self.purge()
        if problems:
            return self.record("clean", "fail", "; ".join(problems))
        self.record("clean", "pass", "; ".join(["nothing left"] + notes))

    def step_routing(self):
        results = smoke_routing(SMOKE_MODELS, self.cfg)
        self.record("routing", "pass" if all(r["ok"] for r in results) else "fail",
                    "; ".join(fmt_smoke(results)[1:]))

    def safe_purge(self):
        try:
            self.purge()
        except BaseException as e:
            print("orch: warning: could not delete the selftest ticket %s: %s"
                  % (self.st["ticket"], e), file=sys.stderr)

    def purge(self):
        tid = self.st["ticket"]
        with transaction(self.db):
            for table, col in (("tickets", "id"), ("events", "ticket"),
                               ("ci_results", "ticket"), ("runs", "ticket")):
                self.db.execute("DELETE FROM %s WHERE %s=?" % (table, col), (tid,))
        for path in (os.path.join(self.sdir, "briefs", tid + ".md"),
                     os.path.join(self.sdir, "briefs", tid + ".resume.md"),
                     log_path(self.sdir, tid)):
            try:
                os.remove(path)
            except OSError:
                pass


def session_processes(sid):
    """Pids of processes with `sid` as a word on their command line."""
    try:
        p = subprocess.run(["ps", "-ax", "-ww", "-o", "pid=,command="],
                           capture_output=True, text=True, timeout=10, env=ps_env())
    except (OSError, subprocess.SubprocessError):
        return []
    out = []
    for line in p.stdout.splitlines():
        parts = line.split()
        if len(parts) > 1 and sid in parts[1:] and parts[0] != str(os.getpid()):
            out.append(int(parts[0]))
    return out


def ddev_project_at(path):
    """Name of a DDEV project rooted at `path`, if ddev knows one; None also
    when ddev is not installed. Raises ToolError when ddev cannot tell."""
    if not shutil.which("ddev"):
        return None
    try:
        p = subprocess.run(["ddev", "list", "--json-output"], capture_output=True,
                           text=True, timeout=60, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as e:
        raise ToolError("`ddev list`: %s" % e)
    try:
        data = json.loads(p.stdout)
    except ValueError:
        data = None
    if p.returncode != 0 or not isinstance(data, dict):
        raise ToolError("`ddev list` exited %d: %s" % (
            p.returncode, (p.stderr.strip() or p.stdout.strip())[:300]))
    for proj in (data.get("raw") or []) if isinstance(data, dict) else []:
        if isinstance(proj, dict) and realpath_or_none(proj.get("approot")) == path:
            return proj.get("name") or path
    return None


def save_run(db, st):
    with transaction(db):
        db.execute("INSERT OR REPLACE INTO selftest_runs (run, state, updated_at)"
                   " VALUES (?,?,?)", (st["run"], json.dumps(st), now()))


def cmd_selftest(args):
    sdir = state_dir()
    db = connect(sdir)
    try:
        if args.cont:
            got = db.execute("SELECT state FROM selftest_runs WHERE run=?",
                             (args.cont,)).fetchone()
            if got is None:
                raise Refusal(EXIT_NOT_FOUND, "no selftest run %s" % args.cont)
            st = json.loads(got["state"])
            try:
                answer = json.loads(args.answer or "{}")
            except ValueError as e:
                raise Refusal(EXIT_USAGE, "--answer is not JSON: %s" % e)
            st["answer"] = answer
        else:
            run = uuid.uuid4().hex[:8]
            st = {"run": run, "ticket": "selftest-" + uuid.uuid4().hex[:8],
                  "platform": None, "timeout": args.timeout, "keep": args.keep,
                  "steps": [], "failed": False, "harness_flag": args.harness,
                  "routing": not args.skip_routing}
        test = Selftest(db, sdir, st)
        stop = None
        try:
            old_term = signal.signal(signal.SIGTERM, raise_terminated)
        except ValueError:  # not the main thread
            old_term = None
        try:
            try:
                out = test.drive()
            except (KeyboardInterrupt, Terminated) as e:
                stop, out = e, None
                test.interrupted(e)
        finally:
            if old_term is not None:
                signal.signal(signal.SIGTERM, old_term)
        if out is not None:
            save_run(db, st)
            print(json.dumps(out))
            return db.publication_error.code if db.publication_error else 0
        if stop is not None:
            save_run(db, st)  # kept: the record of an interrupted run
        else:
            with transaction(db):
                db.execute("DELETE FROM selftest_runs WHERE run=?", (st["run"],))
        ok = stop is None and all(
            s["status"] == "pass" or (s["status"] == "skip" and st["keep"]
                                      and s["name"] in ("teardown", "clean"))
            for s in st["steps"])
        result = {"run": st["run"], "platform": st["platform"],
                  "harness": st.get("harness"), "steps": st["steps"], "ok": ok}
        if stop is not None:
            result["interrupted"] = st["interrupted"]
        if args.json:
            print(json.dumps(result))
        else:
            for s in st["steps"]:
                print("[%s] %s%s" % (s["status"], s["name"],
                                     (": " + s["detail"]) if s["detail"] else ""))
            print("selftest %s on %s (%s): %s" % (st["run"], st["platform"],
                                                  st.get("harness"),
                                                  "ok" if ok else "FAILED"))
        if stop is not None:
            return 143 if isinstance(stop, Terminated) else 130
        return 0 if ok and db.publication_error is None else EXIT_GATE
    finally:
        db.close()


# ---- hook ------------------------------------------------------------------

# Script runtimes that run claude as a script file (npm installs:
# `node .../bin/claude`). Shells are not among them: `zsh -lc claude` is a shell.
INTERPRETER = re.compile(r"(node|bun|deno|python[0-9.]*)\Z")
# Runtime options that run code from an argument, not a script file.
CODE_OPTIONS = re.compile(r"-[A-Za-z]*[cem][A-Za-z]*\Z|--eval\Z|--print\Z")


def agent_of(comm, command):
    """The harness a process with executable `comm` and command line `command`
    is, or None. A harness process's executable is named after it (`claude`,
    `pi`, `codex`; Pi sets its process title to `pi`), or lives in Claude's
    native installer `.../claude/versions/<version>`, or the command runs it
    directly or as an interpreter's script."""
    if comm and "/claude/versions/" in comm:
        return "claude"
    if comm and os.path.basename(comm) in HARNESSES:
        return os.path.basename(comm)
    words = command.split()
    if not words:
        return None
    if os.path.basename(words[0]) in HARNESSES:
        return os.path.basename(words[0])
    if INTERPRETER.match(os.path.basename(words[0]).lower()):
        for w in words[1:]:
            if not w.startswith("-"):
                name = os.path.basename(w)
                return name if name in HARNESSES else None
            if CODE_OPTIONS.match(w):  # `python -m claude`, `node -e ...`
                return None
    return None


def is_claude(comm, command):
    return agent_of(comm, command) == "claude"


def walk_to_agent(pid, levels=8):
    """(pid, harness) of the first harness process from `pid` up (at most
    `levels` processes), or (None, None)."""
    for _ in range(levels):
        if pid <= 1:
            return None, None
        # `comm` is the executable path, which may contain spaces (Claude
        # Desktop's lives under "Application Support"): keep it last.
        try:
            p = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                               capture_output=True, text=True, timeout=3, env=ps_env())
        except (OSError, subprocess.SubprocessError):
            return None, None
        parts = p.stdout.strip().split(None, 1)
        if p.returncode != 0 or not parts:
            return None, None
        comm = parts[1].strip() if len(parts) > 1 else ""
        harness = agent_of(comm, ps_field(pid, "command") or "")
        if harness:
            return pid, harness
        try:
            pid = int(parts[0])
        except ValueError:
            return None, None
    return None, None


def hook_claude_pid():
    """The agent process this hook runs under: the pid the Pi extension names
    (ORCH_HOOK_AGENT_PID), else walk up from our parent (at most 8 levels) to
    the first harness process."""
    for var in ("ORCH_HOOK_CLAUDE_PID", "ORCH_HOOK_AGENT_PID"):
        forced = os.environ.get(var)
        if forced:
            if forced == "none":  # test override: the walk found nothing
                return None
            try:
                return int(forced)
            except ValueError:
                return None
    return walk_to_agent(os.getppid())[0]


def hook_locate(cwd):
    """The state dir for the hook's cwd, or None when there is none. Which
    ticket (if any) the session belongs to is decided by matching the cwd
    against ticket worktrees, so the main orchestrator in the project root
    or main checkout matches none."""
    home = os.environ.get("ORCH_HOME")
    if home:
        return os.path.abspath(home)
    try:
        return os.path.join(project_root(cwd), ".agents", "orchestration")
    except (Refusal, OSError, subprocess.SubprocessError):
        return None

def hook_skip(event, sid, row, pid):
    """True if this hook must leave `row` alone."""
    if event == "SessionStart":
        if row["phase"] == "done":
            return True
        if sid == row["session_id"]:
            return False
        # Until the launched session has reported in, nobody else may take a
        # headless/orca/herdr ticket over: its own SessionStart is on the way.
        if not row["session_seen"] and row_platform(row) != "desktop":
            if row["session_id"] is None and row_harness(row) == "codex":
                # Codex names its thread only in this hook. Headless: only the
                # process orch launched; orca/herdr: the first one to report.
                if row_platform(row) == "headless":
                    return pid is None or pid != row["pid"]
                return False
            return True
        # A different session takes over only from a dead one, or from the
        # same process (`/clear` starts a new session id in place).
        return row_alive(row) and (pid is None or pid != row["pid"])
    if sid != row["session_id"]:
        return True
    if event == "PostToolUse":
        age = age_s(row["last_seen_at"])
        return (row["activity"] == "working" and age is not None
                and age < POST_TOOL_THROTTLE_S)
    return False


TRANSCRIPT_WAIT_S = 2.0


TRANSCRIPT_CHUNK_BYTES = 64 * 1024


def transcript_record(line):
    """Decode one complete record, keeping model and effort from the same object."""
    try:
        obj = json.loads(line.decode("utf-8", errors="replace"))
    except ValueError:
        return None, None
    if not isinstance(obj, dict) or obj.get("type") != "assistant":
        return None, None
    message = obj.get("message")
    model = message.get("model") if isinstance(message, dict) else None
    if not isinstance(model, str) or not model or model.startswith("<"):
        return None, None
    effort = obj.get("effort")
    return model, effort if isinstance(effort, str) and effort else None


class TranscriptReader:
    """Per-call byte offset and unfinished EOF record. No persistent cache."""
    def __init__(self):
        self.identity = None
        self.offset = 0
        self.partial = b""

    def backwards(self, stream, size):
        position = size
        carry = b""
        tail_saved = False
        while position:
            count = min(position, TRANSCRIPT_CHUNK_BYTES)
            position -= count
            stream.seek(position)
            parts = (stream.read(count) + carry).split(b"\n")
            carry = parts[0]
            for line in reversed(parts[1:]):
                if not tail_saved:
                    self.partial = line
                    tail_saved = True
                result = transcript_record(line)
                if result[0]:
                    return result
        if not tail_saved:
            self.partial = carry
        return transcript_record(carry)

    def appended(self, stream, size):
        stream.seek(self.offset)
        result = (None, None)
        while self.offset < size:
            data = stream.read(min(size - self.offset, TRANSCRIPT_CHUNK_BYTES))
            if not data:
                break
            self.offset += len(data)
            parts = (self.partial + data).split(b"\n")
            self.partial = parts.pop()
            for line in parts:
                observed = transcript_record(line)
                if observed[0]:
                    result = observed
        observed = transcript_record(self.partial)
        return observed if observed[0] else result

    def read(self, path):
        try:
            with open(path, "rb") as stream:
                stat = os.fstat(stream.fileno())
                identity = (stat.st_dev, stat.st_ino)
                if identity != self.identity or stat.st_size < self.offset:
                    self.identity = identity
                    self.offset = stat.st_size
                    self.partial = b""
                    return self.backwards(stream, stat.st_size)
                if stat.st_size == self.offset:
                    return None, None
                return self.appended(stream, stat.st_size)
        except OSError:
            self.identity = None
            self.offset = 0
            self.partial = b""
            return None, None


def transcript_model(path):
    """Newest qualifying assistant model and its own top-level effort."""
    return TranscriptReader().read(path)


def subagent_report(payload):
    """(role, agent_id, resolved model, resolved effort, the call's model from
    meta.json) for a
    SubagentStop of a stage agent (`orchestration:<role>`), else None. The
    transcript is written asynchronously: wait up to TRANSCRIPT_WAIT_S."""
    kind = payload.get("agent_type")
    if not isinstance(kind, str) or not kind.startswith("orchestration:"):
        return None
    role = kind[len("orchestration:"):]
    agent_id = payload.get("agent_id")
    agent_id = str(agent_id) if agent_id else "unknown"
    path = payload.get("agent_transcript_path")
    resolved = effort = meta_model = None
    if isinstance(path, str) and path:
        deadline = time.time() + TRANSCRIPT_WAIT_S
        reader = TranscriptReader()
        while True:
            resolved, effort = reader.read(path)
            if resolved or time.time() >= deadline:
                break
            time.sleep(0.2)
        try:
            with open(re.sub(r"\.jsonl\Z", "", path) + ".meta.json") as f:
                meta = json.load(f)
            if isinstance(meta, dict) and isinstance(meta.get("model"), str):
                meta_model = meta["model"]
        except (OSError, ValueError):
            pass
    return role, agent_id, resolved, effort, meta_model


def record_subagent(db, tid, phase, ts, role, agent_id, resolved, effort, meta_model):
    """Attach evidence to a known agent, else the oldest unsuperseded pending run."""
    run = None
    if agent_id and agent_id != "unknown":
        run = db.execute("SELECT * FROM runs WHERE ticket=? AND role=? AND agent_id=?"
                         " ORDER BY seq LIMIT 1", (tid, role, agent_id)).fetchone()
    if run is not None:
        if resolved is None:
            return
        if run["model_resolved"] is not None:
            model_changed = resolved != run["model_resolved"]
            effort_changed = effort is not None and (
                (run["effort_resolved"] is not None
                 and effort != run["effort_resolved"])
                or (run["effort_resolved"] is None
                    and run["effort_requested"] not in (None, effort)))
            if model_changed or effort_changed:
                log_event(db, tid, "model_mismatch", phase, phase,
                          "role=%s run=%s agent_id=%s retained model=%s effort=%s"
                          " observed model=%s effort=%s requested model=%s effort=%s"
                          % (role, run["seq"], agent_id, run["model_resolved"],
                             run["effort_resolved"] or "-", resolved, effort or "-",
                             run["model_requested"], run["effort_requested"] or "-"))
            elif run["effort_resolved"] is None and effort is not None:
                db.execute("UPDATE runs SET effort_resolved=? WHERE seq=?",
                           (effort, run["seq"]))
            return
        # Late first model evidence uses the normal resolution check below.
    else:
        # A recorded retry supersedes its source for anonymous pairing, even
        # after the retry completes. Keep the source as provenance, and let a
        # known source agent's late evidence take the identity path above.
        run = db.execute("SELECT pending.* FROM runs AS pending"
                         " WHERE pending.ticket=? AND pending.role=? AND pending.agent_id IS NULL"
                         " AND NOT EXISTS (SELECT 1 FROM runs AS retry"
                         " WHERE retry.ticket=pending.ticket AND retry.role=pending.role"
                         " AND retry.retry_of=pending.seq)"
                         " ORDER BY pending.seq LIMIT 1", (tid, role)).fetchone()
    if run is None:
        log_event(db, tid, "dispatch_unrecorded", phase, phase,
                  "role=%s resolved=%s requested=%s" % (role, resolved or "-",
                                                        meta_model or "-"))
        return
    if resolved is None:
        db.execute("UPDATE runs SET agent_id=? WHERE seq=?", (agent_id, run["seq"]))
        log_event(db, tid, "model_unresolved", phase, phase,
                  "role=%s agent_id=%s" % (role, agent_id))
        return
    model_ok = resolved.startswith("claude-%s-" % run["model_requested"])
    # A transcript without an effort (older CLIs) is not a mismatch.
    effort_ok = effort is None or run["effort_requested"] in (None, effort)
    db.execute("UPDATE runs SET agent_id=?, model_resolved=?, effort_resolved=?,"
               " resolved_at=?, match=? WHERE seq=?",
               (agent_id, resolved, effort, ts, int(model_ok and effort_ok), run["seq"]))
    if not (model_ok and effort_ok):
        detail = "role=%s requested=%s resolved=%s" % (role, run["model_requested"],
                                                       resolved)
        if not effort_ok:
            detail += " effort requested=%s resolved=%s" % (run["effort_requested"], effort)
        log_event(db, tid, "model_mismatch", phase, phase, detail)


HOOK_KEY_COLUMNS = ("phase", "worktree", "retired_at", "session_id", "pid",
                    "pid_start", "activity", "last_seen_at", "session_seen", "platform")


def run_hook():
    payload = json.loads(sys.stdin.read())
    if not isinstance(payload, dict):
        return
    event = payload.get("hook_event_name")
    sid = payload.get("session_id")
    cwd = payload.get("cwd")
    if event not in HOOK_EVENTS or not isinstance(sid, str) or not sid \
            or not isinstance(cwd, str) or not cwd:
        return
    cwd = os.path.realpath(cwd)
    if not os.path.isdir(cwd):
        return
    sdir = hook_locate(cwd)
    if not sdir or not os.path.isfile(os.path.join(sdir, "state.db")):
        return
    out = None
    db = connect(sdir, timeout=2)
    try:
        with contextlib.suppress(Refusal):
            db.state_root = project_root(cwd)
        # Match under a plain read; most hooks end here without a write lock.
        rows = db.execute("SELECT * FROM tickets WHERE retired_at IS NULL"
                          " AND worktree IS NOT NULL").fetchall()
        # A main checkout (its .git is a directory) is never a ticket's.
        matches = [r for r in rows if contains(r["worktree"], cwd)
                   and not os.path.isdir(os.path.join(r["worktree"], ".git"))]
        if not matches:
            return
        row = max(matches, key=lambda r: (len(r["worktree"]),
                                          r["phase"] != "done", r["seq"]))
        tid = row["id"]
        pid = pid_start = None
        if event == "SessionStart" and row["phase"] != "done":
            pid = hook_claude_pid()
            pid_start = ps_field(pid, "lstart") if pid else None
            if pid_start is None:
                pid = None  # no start time: as good as finding nothing
        if event == "SessionStart" and row["session_id"] is None \
                and row_harness(row) == "codex" and row_platform(row) == "headless" \
                and row["pid"] is None and row["launching"]:
            # The launch records the pid it started right after starting it.
            deadline = time.time() + 3
            while time.time() < deadline and row is not None and row["pid"] is None \
                    and row["launching"]:
                time.sleep(0.1)
                row = db.execute("SELECT * FROM tickets WHERE id=?", (tid,)).fetchone()
        if hook_skip(event, sid, row, pid):
            return
        sub = subagent_report(payload) if event == "SubagentStop" else None
        with transaction(db):
            cur = db.execute("SELECT * FROM tickets WHERE id=?", (tid,)).fetchone()
            if cur is None or cur["retired_at"] is not None \
                    or cur["worktree"] != row["worktree"]:
                return
            if any(cur[c] != row[c] for c in HOOK_KEY_COLUMNS) \
                    and hook_skip(event, sid, cur, pid):
                return
            ts, phase = now(), cur["phase"]
            if event == "SessionStart":
                if sid == cur["session_id"]:
                    # Same session: a failed walk keeps the recorded process.
                    db.execute(
                        "UPDATE tickets SET pid=COALESCE(?, pid), pid_start=CASE WHEN"
                        " ? IS NULL THEN pid_start ELSE ? END, session_seen=1,"
                        " activity='working', last_seen_at=? WHERE id=?",
                        (pid, pid, pid_start, ts, tid))
                else:
                    db.execute(
                        "UPDATE tickets SET session_id=?, pid=?, pid_start=?,"
                        " session_seen=1, activity='working', last_seen_at=? WHERE id=?",
                        (sid, pid, pid_start, ts, tid))
                    log_event(db, tid, "attach", phase, phase, "session=%s source=%s"
                              % (sid, payload.get("source")))
                out = ("You are the ticket orchestrator for %s. Run `orch show %s`"
                       " before anything else." % (tid, tid))
            elif event in ("PostToolUse", "SubagentStop"):
                db.execute("UPDATE tickets SET activity='working', last_seen_at=?"
                           " WHERE id=?", (ts, tid))
                if sub:
                    record_subagent(db, tid, phase, ts, *sub)
            elif event == "Stop":
                db.execute("UPDATE tickets SET activity='idle', last_seen_at=?"
                           " WHERE id=?", (ts, tid))
            else:
                db.execute("UPDATE tickets SET activity='ended', last_seen_at=?"
                           " WHERE id=?", (ts, tid))
                log_event(db, tid, "session_end", phase, phase,
                          "reason=%s" % payload.get("reason"))
    finally:
        try:
            state_md_after_commit(db)
        finally:
            db.close()
    if out:
        print(out)


def cmd_hook(args):
    """Always exit zero; publication failures are diagnosed by the publisher."""
    try:
        run_hook()
    except BaseException:
        pass


# ---- parser ----------------------------------------------------------------

def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="print one JSON object")
    p = argparse.ArgumentParser(prog="orch", parents=[common],
                                description="Orchestration state CLI")
    sub = p.add_subparsers(dest="cmd", metavar="command")
    sub.required = True

    HELP = {
        "init": "create the state directory", "platform": "show the detected platform",
        "preflight": "check required tools", "add": "add a ticket",
        "list": "list tickets", "show": "show one ticket", "next": "list ready tickets that fit the free worker slots",
        "spawn": "start a ticket session", "resume": "resume a ticket session",
        "attach": "attach a session to a ticket", "stale": "list stale tickets",
        "hook": "harness hook entry point", "phase": "move a ticket to a phase",
        "block": "block a ticket", "unblock": "unblock a ticket",
        "ci": "record a CI result", "merged": "mark a ticket merged",
        "retire": "retire a ticket's worktree", "events": "show a ticket's events",
        "route": "pick a model for a role", "run": "record a subagent run",
        "runs": "list a ticket's subagent runs", "smoke-routing": "smoke-test model routing",
        "retry": "replay a recorded stage dispatch",
        "watch": "watch ticket state", "selftest": "run the end-to-end self test",
    }

    def add(name, fn, *ticket_args):
        sp = sub.add_parser(name, parents=[common], help=HELP[name])
        sp.set_defaults(fn=fn)
        for a in ticket_args:
            sp.add_argument(a)
        return sp

    baseline = sub.add_parser("baseline", parents=[common], help="coordinate confirmed shared baseline failures")
    commands = baseline.add_subparsers(dest="baseline_cmd", required=True)
    for name in ("confirm", "show", "gate", "resolve", "refresh", "ack", "recover"):
        bp = commands.add_parser(name, parents=[common])
        bp.set_defaults(fn=cmd_baseline)
        bp.add_argument("ticket" if name == "gate" else "id")
        if name == "confirm":
            bp.add_argument("--owner", required=True)
            bp.add_argument("--affected", action="append", required=True)
            bp.add_argument("--base-sha", required=True)
            bp.add_argument("--command", required=True)
            bp.add_argument("--output", required=True)
            bp.add_argument("--verified", action="store_true")
        if name in ("confirm", "gate"):
            bp.add_argument("--gate", required=True, **({"choices": ("full-suite",)} if name == "confirm" else {}))
        if name == "resolve":
            bp.add_argument("--fix-sha", required=True)
        if name in ("refresh", "ack", "recover"):
            bp.add_argument("--ticket", required=True)
        if name in ("refresh", "recover"):
            bp.add_argument("--stage-boundary", action="store_true")
        if name == "recover":
            bp.add_argument("--stopped", action="store_true")
            bp.add_argument("--evidence", required=True)
        if name == "ack":
            for flag in ("sha", "tests", "review"):
                bp.add_argument("--" + flag, required=True)
    complete = sub.add_parser("complete-run", parents=[common], help="attest a stage invocation and its children have stopped")
    complete.set_defaults(fn=cmd_complete_run)
    complete.add_argument("ticket")
    complete.add_argument("--run", type=int, required=True)
    complete.add_argument("--evidence", required=True)
    complete.add_argument("--stopped", action="store_true")
    sp = sub.add_parser("state-md", parents=[common], help="check or rebuild the committed STATE.md projection")
    sp.set_defaults(fn=cmd_state_md)
    sp.add_argument("operation", choices=("check", "rebuild"))
    add("init", cmd_init)
    add("platform", cmd_platform)
    add("preflight", cmd_preflight)
    sp = add("add", cmd_add, "ticket")
    sp.add_argument("--title", required=True)
    sp.add_argument("--url")
    add("list", cmd_list)
    add("show", cmd_show, "ticket")
    add("next", cmd_next)
    sp = add("spawn", cmd_spawn, "ticket")
    sp.add_argument("--worktree")
    sp.add_argument("--brief-file", required=True)
    sp.add_argument("--platform", choices=PLATFORMS)
    sp.add_argument("--harness", choices=HARNESSES)
    sp = add("resume", cmd_resume, "ticket")
    sp.add_argument("--note")
    sp.add_argument("--platform", choices=PLATFORMS)
    sp.add_argument("--harness", choices=HARNESSES)
    sp = add("attach", cmd_attach, "ticket")
    sp.add_argument("--ref")
    sp.add_argument("--session-id")
    add("stale", cmd_stale)
    add("hook", cmd_hook)
    sp = add("phase", cmd_phase, "ticket")
    sp.add_argument("phase", choices=PHASE_ORDER)
    sp.add_argument("--note")
    sp = add("block", cmd_block, "ticket")
    sp.add_argument("--reason", required=True, help="why it is blocked, recorded in STATE.md")
    add("unblock", cmd_unblock, "ticket")
    sp = add("ci", cmd_ci, "ticket")
    sp.add_argument("--sha", required=True)
    g = sp.add_mutually_exclusive_group(required=True)
    g.add_argument("--passed", action="store_true")
    g.add_argument("--failed", action="store_true")
    sp = add("merged", cmd_merged, "ticket")
    sp.add_argument("--sha", required=True)
    sp.add_argument("--mr", help="MR URL, recorded in STATE.md as the completed line (defaults to 'commit <sha>')")
    sp = add("retire", cmd_retire, "ticket")
    sp.add_argument("--force", action="store_true")
    sp.add_argument("--keep-worktree", action="store_true")
    add("events", cmd_events, "ticket")
    for name, fn in (("route", cmd_route), ("run", cmd_run)):
        sp = add(name, fn, "ticket")
        sp.add_argument("--role", required=True)
        if fn is cmd_run:
            sp.usage = ("%(prog)s [-h] [--json] ticket --role ROLE --model MODEL "
                        "--effort {low,high} [--files FILES] [--lines LINES] [--ambiguous]")
            sp.add_argument("--model", required=True)
            sp.add_argument("--effort", choices=EFFORTS,
                            help="required effort for this run")  # required: cmd_run checks
        sp.add_argument("--files", type=int)
        sp.add_argument("--lines", type=int)
        sp.add_argument("--ambiguous", action="store_true")
    sp = add("retry", cmd_retry, "ticket")
    sp.add_argument("--run", required=True, type=int)
    sp.add_argument("--model")
    sp.add_argument("--effort", choices=EFFORTS)
    sp.add_argument("--reason")
    add("runs", cmd_runs, "ticket")
    sp = add("smoke-routing", cmd_smoke_routing)
    sp.add_argument("--model", action="append", dest="models")
    sp.add_argument("--effort", choices=EFFORTS, default="high",
                    help="requested subagent effort, checked against the transcript (default: high)")
    sp = add("watch", cmd_watch)
    sp.add_argument("--interval", type=float, default=5.0)
    sp.add_argument("--once", action="store_true")
    sp = add("selftest", cmd_selftest)
    sp.add_argument("--harness", choices=HARNESSES)
    sp.add_argument("--keep", action="store_true")
    sp.add_argument("--timeout", type=float, default=180.0)
    sp.add_argument("--continue", dest="cont", metavar="RUN")
    sp.add_argument("--answer")
    sp.add_argument("--skip-routing", action="store_true")
    return p


READ_ONLY = (cmd_list, cmd_show, cmd_next, cmd_stale, cmd_events, cmd_route, cmd_runs)
NO_DB = (cmd_init, cmd_preflight, cmd_platform, cmd_hook, cmd_watch,
         cmd_selftest, cmd_smoke_routing)


def main(argv=None):
    if (argv if argv is not None else sys.argv[1:])[:1] == ["hook"]:
        cmd_hook(None)
        return 0
    args = build_parser().parse_args(argv)
    args.json = getattr(args, "json", False)
    try:
        if args.fn in NO_DB:
            return args.fn(args) or 0
        sdir = state_dir()
        db = connect(sdir)
        try:
            if getattr(args.fn, "own_tx", False):
                args.fn(args, db, sdir)
            else:
                with transaction(db, write=args.fn not in READ_ONLY):
                    args.fn(args, db, sdir)
            if args.fn is not cmd_state_md:
                if db.publication_error is not None:
                    return db.publication_error.code
                state_md_sync(db)
        finally:
            db.close()
        return 0
    except Refusal as e:
        print("orch: %s" % e, file=sys.stderr)
        return e.code


if __name__ == "__main__":
    sys.exit(main())
