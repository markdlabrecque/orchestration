#!/usr/bin/env python3
"""Write the orchestration stage agents (agents/*.md) as Codex agent files.

Codex plugins do not ship agents, so a ticket session on Codex finds the
stage agents in the user's agents directory:

    codex-agents [--out DIR]     # default $CODEX_HOME/agents (~/.codex/agents)

Each agent becomes one file per routing tier, <name>_<tier>.toml (`-`
becomes `_` in the file name), named `<name>-<tier>`, with that tier's model
and reasoning effort; the tools map to a sandbox. `orch route` prints the
agent to spawn. Re-run after the agents change; existing files are replaced,
and the untiered <name>.toml of earlier versions is removed (only when this
script generated it: its first line says so).
"""

import argparse
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
AGENTS = os.path.join(ROOT, "agents")

# The routing tiers (scripts/orch CODEX_MODELS): model, reasoning effort.
TIERS = (("light", "gpt-6-luna", "low"), ("standard", "gpt-6.1-sol", "medium"),
         ("heavy", "gpt-6-astra", "high"), ("frontier", "gpt-6-astra", "xhigh"))
# Agents that must run with the session's own sandbox (the verifier drives a
# browser and DDEV/Docker).
INHERIT_SANDBOX = {"verifier"}


def parse(path):
    text = open(path, encoding="utf-8").read()
    m = re.match(r"^---\r?\n(.*?)\r?\n---\r?\n?(.*)$", text, re.S)
    if not m:
        raise SystemExit("codex-agents: %s has no frontmatter" % path)
    fm = {}
    for line in m.group(1).splitlines():
        k, sep, v = line.partition(":")
        if sep:
            fm[k.strip()] = v.strip()
    return fm, m.group(2).strip()


def sandbox(name, tools):
    if name in INHERIT_SANDBOX:
        return None
    return "workspace-write" if {"Write", "Edit"} & tools else "read-only"


def render(fm, body, tier, model, effort):
    name = fm["name"]
    if "'''" in body:
        raise SystemExit("codex-agents: %s's body contains '''" % name)
    tools = {t.strip() for t in fm.get("tools", "").split(",") if t.strip()}
    lines = ["# Generated by orchestration/scripts/codex-agents from agents/%s.md;"
             " edit that file and re-run." % name,
             "name = %s" % json.dumps("%s-%s" % (name, tier), ensure_ascii=False),
             "description = %s" % json.dumps(fm["description"], ensure_ascii=False),
             "model = %s" % json.dumps(model),
             "model_reasoning_effort = %s" % json.dumps(effort)]
    box = sandbox(name, tools)
    if box:
        lines.append("sandbox_mode = %s" % json.dumps(box))
    lines += ["", "developer_instructions = '''", body, "'''", ""]
    return "\n".join(lines)


def generated(path):
    """True when `path` is a file this script wrote (its first line says so)."""
    try:
        with open(path, encoding="utf-8") as f:
            return f.readline().startswith("# Generated by orchestration/scripts/codex-agents")
    except OSError:
        return False


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    home = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")
    ap.add_argument("--out", default=os.path.join(home, "agents"))
    args = ap.parse_args()
    os.makedirs(args.out, exist_ok=True)
    for n in sorted(os.listdir(AGENTS)):
        if not n.endswith(".md"):
            continue
        fm, body = parse(os.path.join(AGENTS, n))
        base = os.path.join(args.out, fm["name"].replace("-", "_"))
        if generated(base + ".toml"):
            os.remove(base + ".toml")  # untiered, from an earlier version
        for tier, model, effort in TIERS:
            path = "%s_%s.toml" % (base, tier)
            with open(path, "w", encoding="utf-8") as f:
                f.write(render(fm, body, tier, model, effort))
            print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
