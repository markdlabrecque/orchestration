{
  "name": "orchestration",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "bin": {
    "orch": "bin/orch"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
